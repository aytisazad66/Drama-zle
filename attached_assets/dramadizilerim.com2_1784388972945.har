              </button>\n                        <button class=\"v-btn \" data-action=\"watchlist\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-bookmark\"></i>\n                            <span>Liste</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"comments\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-comment\"></i>\n                            <span>Yorum</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"share\"\n                            data-url=\"https://dramadizilerim.com/izle/yeralti-vari-si?s=1&amp;e=76\"\n                            data-title=\"YERALTI VARİSİ - S1 B76\">\n                            <i class=\"fas fa-paper-plane\"></i>\n                            <span>Paylaş</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"playback-rate\">\n                            <i class=\"fas fa-tachometer-alt rate-icon\"></i>\n                            <span class=\"rate-text\">1x</span>\n                        </button>\n                    </div>\n\n                    <div class=\"v-info\">\n                        <h2>YERALTI VARİSİ - S1 B76</h2>\n                        <p>Bölüm 76</p>\n                    </div>\n\n                    <!-- Core Web Vitals: CLS prevention - Watermark Logo with dimensions -->\n                    <div class=\"video-watermark\">\n                                                <img src=\"https://dramadizilerim.com/assets/uploads/logo_1769800704.png\" alt=\"Logo\" loading=\"lazy\" decoding=\"async\" width=\"200\"\n                            height=\"100\" style=\"aspect-ratio: 2/1; object-fit: contain; background-color: transparent;\">\n                    </div>\n                </section>\n            \n                <section class=\"v-slide\" data-index=\"76\" data-vid=\"1640\"\n                    data-epid=\"100882\"\n                    data-url=\"https://dramadizilerim.com/izle/yeralti-vari-si?s=1&e=77\" data-title=\"YERALTI VARİSİ - S1 B77\"\n                    data-valid=\"1\" data-iframe=\"0\"\n                    data-episode=\"77\"\n                    data-season=\"1\">\n\n                    <div class=\"player-wrap\" id=\"player-76\">\n                                                    <div class=\"interaction-overlay\" data-player-overlay=\"76\"></div>\n                                                                            <div class=\"lazy-player\" data-src=\"https://dramadizilerim.com/embed.php?ct=TxG4NU1x4aCqWsQCeyBl3fvnDbl2%2FR%2FCchGTYMPoOGhV3bMNOcQ4j7%2FPGm1RaepJSjm5%2BVWvYvAwQaQFZOBX%2BIiwmE6rS669mECEurm8F3SqAvsjJNW2R8xsZvwFKx%2FkZx8k1E7ZI902nJe2KH3xiW1A%2FQzfdK3mnRFKbMgCKgL45pVqHiLjB%2BTeDMMvA93GImjj8a5wFYQiX%2Fc1EuyyfntmSdfiBhVJlg%2B2sGjImDhZIMYVtRXbiH1dfFB%2FD6o3&iv=Uq6yQWheIKUnnbZ%2BBON9sA%3D%3D&video_id=1640&episode=77&_t=1784381983&logo=L2Fzc2V0cy91cGxvYWRzL2xvZ29fMTc2OTgwMDcwNC5wbmc%3D&sub=aHR0cHM6Ly92aWRlby12Ni5teWRyYW1hd2F2ZS5jb20vdnQvMTg1MTUvNmVlOWFjN2ItYTdhZS00ZjFhLWEwZGMtNTVlZDRhM2M3NjBmLnNydA%3D%3D\"></div>\n                                            </div>\n\n                    <div class=\"v-sidebar\" data-sidebar-trigger>\n                        <button class=\"v-btn \" data-action=\"like\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-heart\"></i>\n                            <span>Beğen</span>\n                        </button>\n                        <button class=\"v-btn \" data-action=\"watchlist\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-bookmark\"></i>\n                            <span>Liste</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"comments\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-comment\"></i>\n                            <span>Yorum</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"share\"\n                            data-url=\"https://dramadizilerim.com/izle/yeralti-vari-si?s=1&amp;e=77\"\n                            data-title=\"YERALTI VARİSİ - S1 B77\">\n                            <i class=\"fas fa-paper-plane\"></i>\n                            <span>Paylaş</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"playback-rate\">\n                            <i class=\"fas fa-tachometer-alt rate-icon\"></i>\n                            <span class=\"rate-text\">1x</span>\n                        </button>\n                    </div>\n\n                    <div class=\"v-info\">\n                        <h2>YERALTI VARİSİ - S1 B77</h2>\n                        <p>Bölüm 77</p>\n                    </div>\n\n                    <!-- Core Web Vitals: CLS prevention - Watermark Logo with dimensions -->\n                    <div class=\"video-watermark\">\n                                                <img src=\"https://dramadizilerim.com/assets/uploads/logo_1769800704.png\" alt=\"Logo\" loading=\"lazy\" decoding=\"async\" width=\"200\"\n                            height=\"100\" style=\"aspect-ratio: 2/1; object-fit: contain; background-color: transparent;\">\n                    </div>\n                </section>\n            \n                <section class=\"v-slide\" data-index=\"77\" data-vid=\"1640\"\n                    data-epid=\"100883\"\n                    data-url=\"https://dramadizilerim.com/izle/yeralti-vari-si?s=1&e=78\" data-title=\"YERALTI VARİSİ - S1 B78\"\n                    data-valid=\"1\" data-iframe=\"0\"\n                    data-episode=\"78\"\n                    data-season=\"1\">\n\n                    <div class=\"player-wrap\" id=\"player-77\">\n                                                    <div class=\"interaction-overlay\" data-player-overlay=\"77\"></div>\n                                                                            <div class=\"lazy-player\" data-src=\"https://dramadizilerim.com/embed.php?ct=Dj30eaSADQBk1FkoN94uqyfkuaruP79NpYs7nvGMnFQo5WhqYfMm9BOGDSUpahERGjLWUuE6uFfM4M0VT%2BoSpPFZu1%2B5aacVhDX4Ta9X3pXbc4ekg6V6PXhb%2FhyvduenTj6G5uQ3pnR00mWHQTvlwaKyWmKn0IulWwFIjw655%2F23OueV7qDr1M1WIO%2BmKqgarBuJe3INdavfVAc4EUk%2FnxYcxd4pXZaLgyDQEK9FDLqBvnE6hUxAEQgNldoTffR8&iv=G0DqzwGM1f3piY9tq19V9A%3D%3D&video_id=1640&episode=78&_t=1784381983&logo=L2Fzc2V0cy91cGxvYWRzL2xvZ29fMTc2OTgwMDcwNC5wbmc%3D&sub=aHR0cHM6Ly92aWRlby12Ni5teWRyYW1hd2F2ZS5jb20vdnQvMTg1MTUvMDFiYjExNzItZmE5NS00OWI1LWJlNmUtZjBlMDU1NGEzYmRjLnNydA%3D%3D\"></div>\n                                            </div>\n\n                    <div class=\"v-sidebar\" data-sidebar-trigger>\n                        <button class=\"v-btn \" data-action=\"like\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-heart\"></i>\n                            <span>Beğen</span>\n                        </button>\n                        <button class=\"v-btn \" data-action=\"watchlist\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-bookmark\"></i>\n                            <span>Liste</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"comments\"\n                            data-video-id=\"1640\">\n                            <i class=\"fas fa-comment\"></i>\n                            <span>Yorum</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"share\"\n                            data-url=\"https://dramadizilerim.com/izle/yeralti-vari-si?s=1&amp;e=78\"\n                            data-title=\"YERALTI VARİSİ - S1 B78\">\n                            <i class=\"fas fa-paper-plane\"></i>\n                            <span>Paylaş</span>\n                        </button>\n                        <button class=\"v-btn\" data-action=\"playback-rate\">\n                            <i class=\"fas fa-tachometer-alt rate-icon\"></i>\n                            <span class=\"rate-text\">1x</span>\n                        </button>\n                    </div>\n\n                    <div class=\"v-info\">\n                        <h2>YERALTI VARİSİ - S1 B78</h2>\n                        <p>Bölüm 78</p>\n                    </div>\n\n                    <!-- Core Web Vitals: CLS prevention - Watermark Logo with dimensions -->\n                    <div class=\"video-watermark\">\n                                                <img src=\"https://dramadizilerim.com/assets/uploads/logo_1769800704.png\" alt=\"Logo\" loading=\"lazy\" decoding=\"async\" width=\"200\"\n                            height=\"100\" style=\"aspect-ratio: 2/1; object-fit: contain; background-color: transparent;\">\n                    </div>\n                </section>\n                    </div>\n    </div>\n\n    <!-- SHARE MODAL -->\n    <div class=\"modal-overlay\" id=\"modalOverlay\" onclick=\"if (!window.__cfRLUnblockHandlers) return false; closeShareModal()\" style=\"position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:1999; display:none;\" data-cf-modified-a6f0efca0c24a2e4b88d0c8d-=\"\"></div>\n    <div class=\"share-modal\" id=\"shareModal\">\n        <div style=\"text-align:center; font-weight:700; color:#fff; margin-bottom:20px;\">\n            Paylaş        </div>\n        <div style=\"display:grid; grid-template-columns:repeat(4,1fr); gap:15px; margin-bottom:20px;\">\n            <div data-share-platform=\"wa\" style=\"text-align:center; color:#fff; cursor:pointer;\">\n                <div\n                    style=\"width:50px; height:50px; background:#25d366; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 5px;\">\n                    <i class=\"fab fa-whatsapp\"></i>\n                </div><span style=\"font-size:0.7rem;\">WhatsApp</span>\n            </div>\n            <div data-share-platform=\"tg\" style=\"text-align:center; color:#fff; cursor:pointer;\">\n                <div\n                    style=\"width:50px; height:50px; background:#0088cc; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 5px;\">\n                    <i class=\"fab fa-telegram-plane\"></i>\n                </div><span style=\"font-size:0.7rem;\">Telegram</span>\n            </div>\n            <div data-share-platform=\"fb\" style=\"text-align:center; color:#fff; cursor:pointer;\">\n                <div\n                    style=\"width:50px; height:50px; background:#3b5998; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 5px;\">\n                    <i class=\"fab fa-facebook-f\"></i>\n                </div><span style=\"font-size:0.7rem;\">Facebook</span>\n            </div>\n            <div data-share-platform=\"tw\" style=\"text-align:center; color:#fff; cursor:pointer;\">\n                <div\n                    style=\"width:50px; height:50px; background:#1da1f2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 5px;\">\n                    <i class=\"fab fa-x-twitter\"></i>\n                </div><span style=\"font-size:0.7rem;\">Twitter</span>\n            </div>\n        </div>\n        <div style=\"background:rgba(255,255,255,0.1); border-radius:10px; padding:10px; display:flex; gap:10px;\">\n            <input type=\"text\" id=\"shareLinkInput\" readonly\n                style=\"background:transparent; border:none; color:#fff; flex:1; outline:none; font-size:0.8rem;\">\n            <button data-action=\"copy-share-link\"\n                style=\"background:var(--c-primary); color:#fff; border:none; padding:5px 15px; border-radius:5px; font-weight:700; cursor:pointer;\">Kopyala</button>\n        </div>\n    </div>\n\n    <!-- COMMENTS DRAWER (Simple) -->\n    <div id=\"commentDrawer\"\n        style=\"position:fixed; right:-100%; top:0; width:100%; max-width:400px; height:100%; background:rgba(18,18,18,0.98); backdrop-filter:blur(30px); z-index:1500; transition:right 0.3s ease; border-left:1px solid rgba(255,255,255,0.1); display:flex; flex-direction:column; touch-action:auto !important;\">\n        <div\n            style=\"padding:20px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1);\">\n            <h3 style=\"margin:0; color:#fff;\">Yorumlar</h3>\n            <i class=\"fas fa-times\" data-action=\"close-drawer\"\n                style=\"cursor:pointer; color:#fff; font-size:1.2rem;\"></i>\n        </div>\n        <div id=\"commentList\" style=\"flex:1; overflow-y:auto !important; -webkit-overflow-scrolling:touch !important; padding:20px; touch-action:pan-y !important; pointer-events:auto !important;\"></div>\n        <div style=\"padding:20px; border-top:1px solid rgba(255,255,255,0.1); background: #121212;\">\n            <div style=\"display:flex; gap:10px;\">\n                <input type=\"text\" id=\"commentInput\"\n                    placeholder=\"Yorum yazın...\"\n                    style=\"flex:1; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15); border-radius:20px; padding:10px 15px; color:#fff; outline:none; font-size: 14px;\">\n                <button data-action=\"post-comment\"\n                    style=\"width:40px; height:40px; border-radius:50%; background:var(--c-primary); color:#fff; border:none; cursor:pointer;\"><i\n                        class=\"fas fa-paper-plane\"></i></button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Comments Drawer End -->\n\n    <!-- Floating Unmute Indicator -->\n    <div id=\"unmuteIndicator\" style=\"position: absolute; bottom: 130px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.85); border: 1px solid rgba(255,255,255,0.25); padding: 10px 20px; border-radius: 30px; color: #fff; font-size: 0.9rem; font-weight: 700; display: none; align-items: center; gap: 10px; z-index: 250; cursor: pointer; pointer-events: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.6); transition: opacity 0.3s ease;\">\n        <i class=\"fas fa-volume-mute\" style=\"color: #e50914; font-size: 1.1rem; animation: unmutePulse 1.5s infinite;\"></i>\n        <span>Sesi Açmak İçin Dokunun</span>\n        <style>\n            @keyframes unmutePulse {\n                0%, 100% { transform: scale(1); opacity: 1; }\n                50% { transform: scale(1.2); opacity: 0.7; }\n            }\n        </style>\n    </div>\n\n    <!-- Auto-Play Countdown Overlay -->\n    <div class=\"autoplay-countdown\" id=\"autoplayCountdown\">\n        <div class=\"autoplay-icon\">\n            <i class=\"fas fa-play-circle\"></i>\n        </div>\n        <div class=\"autoplay-timer\" id=\"autoplayTimer\">2</div>\n        <div class=\"autoplay-text\">saniye sonra sonraki bölüm</div>\n        <div class=\"autoplay-actions\">\n            <button class=\"autoplay-btn autoplay-btn-play\" data-action=\"autoplay-play\">\n                <i class=\"fas fa-play\"></i> Şimdi Oynat            </button>\n            <button class=\"autoplay-btn autoplay-btn-cancel\" data-action=\"autoplay-cancel\">\n                <i class=\"fas fa-times\"></i> İptal            </button>\n        </div>\n    </div>\n\n    <!-- Toast Notification -->\n    <div class=\"toast-notification\" id=\"toastNotification\">\n        <div class=\"toast-icon\" id=\"toastIcon\"></div>\n        <div class=\"toast-text\" id=\"toastText\"></div>\n    </div>\n\n    <script type=\"a6f0efca0c24a2e4b88d0c8d-text/javascript\">\n        // --- REWRITTEN CORE ENGINE ---\n\n        // Best Practices: Get CSRF token from meta\n        const csrfToken = document.querySelector('meta[name=\"csrf-token\"]')?.getAttribute('content') || '';\n\n        // CONFIG: WATERMARK LOGO - Sanitized\n        const watermarkLogo = '/assets/uploads/logo_1769800704.png';\n\n        // Count slides\n        const allSlides = document.querySelectorAll('.v-slide');\n\n        // Best Practices: GLOBAL EVENT DELEGATE for interaction overlays\n        document.addEventListener('click', function (e) {\n            const overlay = e.target.closest('.interaction-overlay');\n            if (!overlay) return;\n\n            // Don't handle click if it's on a button, sidebar, or UI element\n            if (e.target.closest('.v-btn') ||\n                e.target.closest('.v-sidebar') ||\n                e.target.closest('.v-info') ||\n                e.target.closest('.v-top-bar') ||\n                e.target.closest('button') ||\n                e.target.closest('a') ||\n                e.target.closest('input') ||\n                e.target.closest('.share-modal') ||\n                e.target.closest('.toast-notification') ||\n                e.target.closest('.autoplay-countdown')) {\n                return;\n            }\n\n            // Single click - toggle play/pause\n            const playerWrap = overlay.closest('.player-wrap');\n            if (playerWrap) {\n                const wrap = playerWrap;\n                window.togglePlay(wrap, e);\n            }\n        });\n\n        // Best Practices: Event delegation for sidebar buttons\n        document.addEventListener('click', function (e) {\n            const btn = e.target.closest('[data-action]');\n            if (!btn) return;\n\n            const action = btn.dataset.action;\n            const videoId = btn.dataset.videoId;\n\n            try {\n                switch (action) {\n                    case 'like':\n                        toggleLike(parseInt(videoId), btn, e);\n                        break;\n                    case 'watchlist':\n                        toggleWatchlist(parseInt(videoId), btn, e);\n                        break;\n                    case 'comments':\n                        openComments(parseInt(videoId), e);\n                        break;\n                    case 'share':\n                        openShareModal(btn.dataset.url, btn.dataset.title, e);\n                        break;\n                    case 'playback-rate':\n                        cyclePlaybackRate(e);\n                        break;\n                    case 'close-drawer':\n                        closeDrawer();\n                        break;\n                    case 'post-comment':\n                        postComment();\n                        break;\n                    case 'copy-share-link':\n                        copyShareLink();\n                        break;\n                    case 'autoplay-play':\n                    case 'autoplay-cancel':\n                        cancelAutoplayCountdown();\n                        if (action === 'autoplay-play') autoplayNext();\n                        break;\n                }\n            } catch (err) {\n                console.error('Action error:', err);\n            }\n        });\n\n        // Best Practices: Event delegation for share platforms\n        document.addEventListener('click', function (e) {\n            const platform = e.target.closest('[data-share-platform]');\n            if (platform) {\n                shareTo(platform.dataset.sharePlatform);\n            }\n        });\n\n        // State\n        const state = {\n            index: 0,\n            total: allSlides.length,\n            isAnimating: false,\n            height: window.innerHeight,\n            uiHidden: false,\n            uiTimer: null,\n            autoPlayNext: true, // AUTO-PLAY IS ON BY DEFAULT\n            countdownTimer: null,\n            countdownValue: 2, // Countdown is 2 seconds\n            // Playback rate state - persists across episodes\n            playbackRate: 1.0\n        };\n\n        // Global variables for modals and comments\n        let activeVideoId = null;\n        let currentShareUrl = '';\n        let currentShareTitle = '';\n\n        // Elements\n        const track = document.getElementById('track');\n        const scroller = document.getElementById('mainScroller');\n\n        // 1. RESIZE HANDLER\n        function onResize() {\n            state.height = window.innerHeight;\n            document.querySelectorAll('.v-slide').forEach(s => s.style.height = state.height + 'px');\n            updateTransform(0);\n        }\n        window.addEventListener('resize', onResize);\n        onResize();\n\n        // 2. SCROLL ENGINE\n        function updateTransform(duration = 400) {\n            // Önceki videoyu durdur - TÜM previous slide'lardaki videoları durdur\n            document.querySelectorAll('.v-slide.active').forEach(prevSlide => {\n                if (prevSlide.dataset.index != state.index) {\n                    const prevIframe = prevSlide.querySelector('iframe');\n                    const prevWrap = prevSlide.querySelector('.player-wrap');\n\n                    // İframe'i tamamen kaldır (Vimeo/YouTube için)\n                    if (prevIframe) {\n                        const originalSrc = prevIframe.src;\n                        // Orijinal src'yi slide'a kaydet (daha sonra tekrar yüklemek için)\n                        if (originalSrc && originalSrc !== 'about:blank') {\n                            prevSlide.setAttribute('data-paused-src', originalSrc);\n                        }\n                        // İframe'i DOM'dan tamamen kaldır\n                        prevIframe.remove();\n                    }\n\n                    // Player wrap'i paused olarak işaretle\n                    if (prevWrap) {\n                        prevWrap.classList.add('paused');\n                        prevWrap.classList.remove('active');\n                    }\n\n                    prevSlide.classList.remove('active');\n                }\n            });\n\n            track.style.transition = duration === 0 ? 'none' : `transform ${duration}ms cubic-bezier(0.2, 1, 0.3, 1)`;\n            track.style.transform = `translate3d(0, -${state.index * state.height}px, 0)`;\n\n            document.querySelectorAll('.v-slide').forEach((s, i) => {\n                s.style.zIndex = (i === state.index) ? 10 : 1;\n            });\n\n            const active = document.querySelector(`.v-slide[data-index=\"${state.index}\"]`);\n            if (active) {\n                // Add active classes to the new active slide and its player-wrap\n                active.classList.add('active');\n                const activeWrap = active.querySelector('.player-wrap');\n                if (activeWrap) {\n                    activeWrap.classList.remove('paused');\n                    activeWrap.classList.add('active');\n                }\n\n                // History API - Cross-origin hatasını önle\n                try {\n                    history.replaceState(null, '', active.dataset.url);\n                } catch (e) {\n                    // Cross-origin hatası - URL değiştirmeyi dene (daha güvenli)\n                    try {\n                        const url = new URL(active.dataset.url, window.location.origin);\n                        history.replaceState(null, '', url.pathname + url.search);\n                    } catch (e2) {\n                        // History API tamemen çalışmıyor - sessizce geç\n                    }\n                }\n\n                // Title güncelle (ayrı try-catch)\n                try {\n                    document.title = active.dataset.title;\n                } catch (e) {\n                    // Title güncelleme hatası - sessizce geç\n                }\n\n                loadVideo(active);\n                // Trigger ad refresh on slide change\n                if (typeof triggerAds === 'function') triggerAds();\n\n                // Background Preloading: Preload the next video in the background after 2 seconds\n                const nextIdx = state.index + 1;\n                if (nextIdx < state.total) {\n                    const nextSlide = document.querySelector(`.v-slide[data-index=\"${nextIdx}\"]`);\n                    if (nextSlide) {\n                        setTimeout(() => {\n                            // Ensure the user hasn't swiped away during the 2-second delay\n                            if (state.index === nextIdx - 1) {\n                                loadVideo(nextSlide, true); // true = isPreload\n                            }\n                        }, 2000);\n                    }\n                }\n            }\n        }\n\n        function goTo(idx) {\n            if (idx < 0 || idx >= state.total || state.isAnimating) return;\n\n            // Detect Episode 1 by its data-episode attribute, NOT by array index.\n            // If we are currently ON Episode 1 or navigating TO Episode 1, do a full\n            // page reload so that the ad script is properly isolated.\n            const currentSlideEl = allSlides[state.index];\n            const targetSlideEl  = allSlides[idx];\n            const currentEp = currentSlideEl ? parseInt(currentSlideEl.dataset.episode || '0') : 0;\n            const targetEp  = targetSlideEl  ? parseInt(targetSlideEl.dataset.episode  || '0') : 0;\n\n            const showPlayerAdLoaded = true;\n            if (showPlayerAdLoaded && typeof window.isAdUnlocked === 'function' && window.isAdUnlocked()) {\n                if (targetSlideEl && targetSlideEl.dataset.url) {\n                    window.location.href = targetSlideEl.dataset.url;\n                    return;\n                }\n            }\n\n            if (currentEp === 1 || targetEp === 1) {\n                if (targetSlideEl && targetSlideEl.dataset.url) {\n                    window.location.href = targetSlideEl.dataset.url;\n                    return;\n                }\n            }\n\n            state.isAnimating = true;\n            state.index = idx;\n            updateTransform(400);\n            setTimeout(() => state.isAnimating = false, 400);\n        }\n\n        // 3. LAZY LOADING\n        function loadVideo(slide, isPreload = false) {\n            const wrap = slide.querySelector('.player-wrap');\n            if (!wrap) {\n                return;\n            }\n\n            const slideIndex = slide.dataset.index;\n            const isValid = slide.dataset.valid === '1';\n\n            // Skip invalid slides (no source URL)\n            if (!isValid) {\n                return;\n            }\n\n            // Reuse existing preloaded/loaded iframe instead of recreating it\n            const existingIframe = slide.querySelector('iframe');\n            if (existingIframe) {\n                if (!isPreload) {\n                    const isVimeo = existingIframe.src.includes('vimeo.com');\n                    const isYouTube = existingIframe.src.includes('youtube.com') || existingIframe.src.includes('youtube-nocookie.com');\n                    try {\n                        if (existingIframe.contentWindow) {\n                            if (isVimeo) {\n                                existingIframe.contentWindow.postMessage(JSON.stringify({ method: 'play' }), '*');\n                            }\n                            if (isYouTube) {\n                                existingIframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo' }), '*');\n                            }\n                            existingIframe.contentWindow.postMessage('play', '*');\n                        }\n                    } catch (e) {}\n                }\n                return;\n            }\n\n            let srcUrl = '';\n            const lazy = wrap.querySelector('.lazy-player');\n            const pausedSrc = slide.getAttribute('data-paused-src');\n\n            if (lazy) {\n                srcUrl = lazy.dataset.src;\n            } else if (pausedSrc && !slide.querySelector('iframe')) {\n                srcUrl = pausedSrc;\n                slide.removeAttribute('data-paused-src');\n            }\n\n            if (srcUrl) {\n                if (srcUrl === 'undefined' || srcUrl.length < 10) {\n                    // Show error message in the player wrap\n                    wrap.innerHTML = `\n                    <div style=\"display:flex;align-items:center;justify-content:center;height:100%;color:#fff;flex-direction:column;gap:10px;\">\n                        <i class=\"fas fa-exclamation-triangle\" style=\"font-size:3rem;color:#e50914;\"></i>\n                        <p style=\"font-size:1.2rem;\">Video Yüklenemedi</p>\n                        <small style=\"opacity:0.7;\">URL hatası - Bölüm ${parseInt(slideIndex) + 1}</small>\n                    </div>\n                `;\n                    return;\n                }\n\n                const ifrm = document.createElement('iframe');\n                ifrm.src = srcUrl;\n                // iOS FIX: 'playsinline' feature policy yerine HTML attributes kullan\n                ifrm.allow = \"autoplay; encrypted-media; fullscreen; picture-in-picture\";\n                ifrm.setAttribute('allowfullscreen', '');\n                ifrm.setAttribute('webkit-playsinline', '');\n                // iOS Safari için x5 attributes (Tencent QQ/WeChat)\n                ifrm.setAttribute('x5-playsinline', '');\n                ifrm.setAttribute('x5-video-player-type', 'h5');\n                ifrm.setAttribute('x5-video-player-fullscreen', 'true');\n                ifrm.style.width = '100%';\n                ifrm.style.height = '100%';\n                ifrm.style.border = 'none';\n\n                // Performance: Add loading attributes\n                ifrm.loading = 'lazy';\n                ifrm.fetchpriority = 'high';\n\n                // Error handling for iframe load\n                ifrm.onload = function () {\n                    // Iframe loaded - setup auto-play API registration\n                    try {\n                        if (ifrm && ifrm.contentWindow) {\n                            ifrm.contentWindow.postMessage('registerAutoPlay', '*');\n\n                            // Only trigger playback if this is NOT a background preloading call\n                            if (!isPreload) {\n                                const isVimeo = ifrm.src.includes('vimeo.com');\n                                const isYouTube = ifrm.src.includes('youtube.com') || ifrm.src.includes('youtube-nocookie.com');\n\n                                // We set a small timeout to ensure the player inside the iframe has completely initialized\n                                setTimeout(() => {\n                                    try {\n                                        if (ifrm && ifrm.contentWindow) {\n                                            if (isVimeo) {\n                                                ifrm.contentWindow.postMessage(JSON.stringify({ method: 'setVolume', value: 1 }), '*');\n                                                ifrm.contentWindow.postMessage(JSON.stringify({ method: 'play' }), '*');\n                                            }\n                                            if (isYouTube) {\n                                                ifrm.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'unMute' }), '*');\n                                                ifrm.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'setVolume', args: [100] }), '*');\n                                                ifrm.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo' }), '*');\n                                            }\n                                            \n                                            // Automatically start playback inside the iframe\n                                            ifrm.contentWindow.postMessage('play', '*');\n                                        }\n                                    } catch (err) {\n                                        // Iframe was likely removed or cross-origin access failed\n                                    }\n                                }, 500);\n                            }\n                        }\n\n                    } catch (e) {\n                        // Cross-origin - iframe'in içine erişemiyoruz, sorun değil\n                    }\n                };\n\n                wrap.innerHTML = '';\n\n                // İframe için wheel/touch event handler ekle (scroll için)\n                // Vimeo/YouTube iframe'lerinde scroll'u yakalamak için\n                ifrm.addEventListener('wheel', function (e) {\n                    // Doğrudan slide değiştir\n                    if (Math.abs(e.deltaY) > 20) {\n                        if (e.deltaY > 0) goTo(state.index + 1);\n                        else goTo(state.index - 1);\n                    }\n                }, { passive: true });\n\n                // Touch events için de aynı\n                let iframeTouchStartY = 0;\n                ifrm.addEventListener('touchstart', function (e) {\n                    if (e.touches && e.touches.length > 0) {\n                        iframeTouchStartY = e.touches[0].clientY;\n                    }\n                }, { passive: true });\n\n                ifrm.addEventListener('touchend', function (e) {\n                    if (e.changedTouches && e.changedTouches.length > 0) {\n                        const iframeTouchEndY = e.changedTouches[0].clientY;\n                        const diff = iframeTouchStartY - iframeTouchEndY;\n\n                        // Swipe yeterince büyükse slide değiştir\n                        if (Math.abs(diff) > 50) {\n                            if (diff > 0) goTo(state.index + 1);\n                            else goTo(state.index - 1);\n                        }\n                    }\n                }, { passive: true });\n\n                // Add interaction-overlay for all embeds\n                const slide = wrap.closest('.v-slide');\n                const isIframeEmbed = slide && slide.dataset.iframe === '1';\n\n                const ov = document.createElement('div');\n                ov.className = isIframeEmbed ? 'interaction-overlay iframe-mode' : 'interaction-overlay';\n                ov.dataset.playerOverlay = slideIndex;\n                wrap.appendChild(ov);\n\n                wrap.appendChild(ifrm);\n\n                // Mark slide as active\n                if (!isPreload) {\n                    slide.classList.add('active');\n                }\n\n                // Apply saved playback rate\n                setTimeout(() => applyPlaybackRate(slide), 500);\n            } else {\n                // Already has an iframe - autoplay!\n                if (!isPreload) {\n                    slide.classList.add('active');\n                }\n                \n                const iframe = wrap.querySelector('iframe');\n                if (iframe && iframe.contentWindow) {\n                    try {\n                        if (!isPreload) {\n                            iframe.contentWindow.postMessage('play', '*');\n                            \n                            const isVimeo = iframe.src.includes('vimeo.com');\n                            const isYouTube = iframe.src.includes('youtube.com') || iframe.src.includes('youtube-nocookie.com');\n                            if (isVimeo) {\n                                iframe.contentWindow.postMessage(JSON.stringify({ method: 'play' }), '*');\n                            }\n                            if (isYouTube) {\n                                iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo' }), '*');\n                            }\n                        }\n                    } catch (e) {}\n                }\n\n                // Apply saved playback rate\n                applyPlaybackRate(slide);\n            }\n\n            if (!isPreload) {\n                // Mark player wrap as playing (remove paused class to show play state)\n                wrap.classList.remove('paused');\n\n                // Pause other iframes (with safety checks using closest)\n                document.querySelectorAll('iframe').forEach(fr => {\n                    try {\n                        const parentSlide = fr.closest('.v-slide');\n                        if (parentSlide && parentSlide !== slide && fr.contentWindow) {\n                            fr.contentWindow.postMessage('pause', '*');\n                            parentSlide.classList.remove('active');\n                        }\n                    } catch (e) {\n                        // Ignore cross-origin errors\n                    }\n                });\n            }\n        }\n\n        // 4. INPUT HANDLING\n        let startY = 0;\n        let isScrolling = false;\n\n        // Core Web Vitals: INP optimization - event listeners\n        // Wheel - scroll engine\n        window.addEventListener('wheel', (e) => {\n            // Eğer kullanıcı UI elementleriyle etkileşim halindeyse scroll'u engelleme\n            if (e.target.closest('.v-sidebar') ||\n                e.target.closest('.share-modal') ||\n                e.target.closest('.toast-notification') ||\n                e.target.closest('.autoplay-countdown') ||\n                e.target.closest('input') ||\n                e.target.closest('textarea') ||\n                e.target.closest('.comment-list')) {\n                return;\n            }\n\n            if (Math.abs(e.deltaY) > 20) {\n                e.preventDefault(); // Varsayılan scroll davranışını engelle\n                if (e.deltaY > 0) goTo(state.index + 1);\n                else goTo(state.index - 1);\n            }\n        }, { passive: false, capture: false });\n\n        // Touch start - pozisyonu kaydet\n        window.addEventListener('touchstart', (e) => {\n            if (e.touches && e.touches.length > 0) {\n                startY = e.touches[0].clientY;\n            }\n            showUI();\n            isScrolling = false;\n        }, { passive: false });\n\n        // Touch move - scroll yönünü tespit et\n        window.addEventListener('touchmove', (e) => {\n            // UI elementlerinde ve yorum çekmecesinde scroll'a izin ver, slide geçişini engelle\n            if (e.target.closest('.v-sidebar') ||\n                e.target.closest('.share-modal') ||\n                e.target.closest('#commentDrawer') ||\n                e.target.closest('#commentList') ||\n                e.target.closest('input') ||\n                e.target.closest('textarea')) {\n                // Yorum çekmecesi için dikey kaydırmaya (scroll) izin ver, engelleme yapma\n                isScrolling = false; \n                return; // Buradaki e.preventDefault() kısmına girmeden çıkıyoruz, böylece tarayıcının kendi dikey kaydırması çalışıyor.\n            }\n\n            if (e.touches && e.touches.length > 0) {\n                const currentY = e.touches[0].clientY;\n                const diff = startY - currentY;\n\n                // Yatay scroll'u engelleme, sadece dikey scroll\n                if (Math.abs(diff) > 10) {\n                    isScrolling = true;\n                    // Sadece vertical scroll'a izin ver\n                    if (e.cancelable) {\n                        e.preventDefault();\n                    }\n                }\n            }\n        }, { passive: false });\n\n        // Touch end - slide değiştir\n        window.addEventListener('touchend', (e) => {\n            if (!isScrolling) return;\n\n            // Eğer yorum çekmecesi veya form elementlerinden birine dokunulduysa hiçbir şey yapma\n            if (e.target.closest('#commentDrawer') ||\n                e.target.closest('input') ||\n                e.target.closest('textarea')) {\n                isScrolling = false;\n                return;\n            }\n\n            if (e.changedTouches && e.changedTouches.length > 0) {\n                const currentY = e.changedTouches[0].clientY;\n                const diff = startY - currentY;\n\n                if (Math.abs(diff) > 50) {\n                    if (diff > 0) goTo(state.index + 1);\n                    else goTo(state.index - 1);\n                }\n            }\n\n            isScrolling = false;\n        }, { passive: false });\n\n\n        // 5. UI LOGIC\n        function showUI() {\n            document.body.classList.remove('v-ui-hidden');\n            clearTimeout(state.uiTimer);\n            state.uiTimer = setTimeout(() => {\n                document.body.classList.add('v-ui-hidden');\n            }, 3500);\n        }\n        document.addEventListener('click', (e) => {\n            if (!e.target.closest('.v-btn')) showUI();\n        });\n        showUI();\n\n        // Load saved playback rate from localStorage\n        try {\n            const savedRate = localStorage.getItem('playbackRate');\n            if (savedRate) {\n                state.playbackRate = parseFloat(savedRate);\n            }\n        } catch (err) {\n        }\n        updatePlaybackRateDisplay();\n\n        // 6. PLAYER CONTROLS\n        window.togglePlay = function (wrap, e) {\n            const playerWrap = wrap.classList.contains('player-wrap') ? wrap : wrap.closest('.player-wrap');\n            if (!playerWrap) return;\n\n            const iframe = playerWrap.querySelector('iframe');\n            if (!iframe) return;\n\n            const isVimeo = iframe.src.includes('vimeo.com');\n            const isYouTube = iframe.src.includes('youtube.com') || iframe.src.includes('youtube-nocookie.com');\n\n            // Hide unmute indicator if any manual play/gesture action occurs\n            const indicator = document.getElementById('unmuteIndicator');\n            if (indicator) indicator.style.display = 'none';\n\n            if (playerWrap.classList.contains('paused')) {\n                let success = false;\n                try {\n                    // Try direct synchronous same-origin video play to preserve user gesture stack on mobile\n                    if (iframe.contentDocument) {\n                        const nativeVideo = iframe.contentDocument.querySelector('video');\n                        if (nativeVideo) {\n                            nativeVideo.muted = false; // Automatically restore sound on direct interaction\n                            nativeVideo.play().catch(err => {\n                                console.warn('[Player] Direct play failed, falling back to postMessage:', err);\n                                iframe.contentWindow.postMessage('play', '*');\n                            });\n                            success = true;\n                        }\n                    }\n                } catch (err) {\n                    console.warn('[Player] Same-origin direct play check omitted:', err);\n                }\n\n                if (!success) {\n                    iframe.contentWindow.postMessage('play', '*');\n                }\n\n                if (isVimeo) {\n                    iframe.contentWindow.postMessage(JSON.stringify({ method: 'setVolume', value: 1 }), '*');\n                    iframe.contentWindow.postMessage(JSON.stringify({ method: 'play' }), '*');\n                }\n                if (isYouTube) {\n                    iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'unMute' }), '*');\n                    iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'setVolume', args: [100] }), '*');\n                    iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo' }), '*');\n                }\n                playerWrap.classList.remove('paused');\n            } else {\n                let success = false;\n                try {\n                    if (iframe.contentDocument) {\n                        const nativeVideo = iframe.contentDocument.querySelector('video');\n                        if (nativeVideo) {\n                            nativeVideo.pause();\n                            success = true;\n                        }\n                    }\n                } catch (err) {}\n\n                if (!success) {\n                    iframe.contentWindow.postMessage('pause', '*');\n                }\n\n                if (isVimeo) iframe.contentWindow.postMessage(JSON.stringify({ method: 'pause' }), '*');\n                if (isYouTube) iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'pauseVideo' }), '*');\n                playerWrap.classList.add('paused');\n            }\n            showUI();\n        }\n\n        // Cycle through playback rates: 1x -> 1.25x -> 1.5x -> 2x -> 1x\n        function cyclePlaybackRate(e) {\n\n            const rates = [1.0, 1.25, 1.5, 2.0];\n            const currentIndex = rates.indexOf(state.playbackRate);\n            const nextIndex = (currentIndex + 1) % rates.length;\n            state.playbackRate = rates[nextIndex];\n\n            // Update UI\n            updatePlaybackRateDisplay();\n\n            // Show toast immediately\n            showToast(state.playbackRate + 'x');\n\n            // Apply to current video\n            const currentSlide = allSlides[state.index];\n            const iframe = currentSlide.querySelector('iframe');\n            if (iframe && iframe.contentWindow) {\n                try {\n                    iframe.contentWindow.postMessage({ type: 'setPlaybackRate', rate: state.playbackRate }, '*');\n                } catch (err) {\n                }\n            }\n\n            // Save to localStorage\n            try {\n                localStorage.setItem('playbackRate', state.playbackRate.toString());\n            } catch (err) {\n            }\n\n            showUI();\n        }\n\n        // Update playback rate display in sidebar\n        function updatePlaybackRateDisplay() {\n            // Update ALL rate texts in all slides (since they share the same state)\n            document.querySelectorAll('.rate-text').forEach(el => {\n                el.textContent = state.playbackRate + 'x';\n            });\n\n            // Update icons in all slides\n            document.querySelectorAll('.rate-icon').forEach(el => {\n                el.className = state.playbackRate > 1.0 ? 'fas fa-forward rate-icon' : 'fas fa-tachometer-alt rate-icon';\n            });\n        }\n\n        // Apply saved playback rate when video loads\n        function applyPlaybackRate(slide) {\n            const iframe = slide.querySelector('iframe');\n            if (iframe && iframe.contentWindow) {\n                try {\n                    iframe.contentWindow.postMessage({ type: 'setPlaybackRate', rate: state.playbackRate }, '*');\n                } catch (err) {\n                }\n            }\n        }\n\n\n        // SIDEBAR & MODAL FUNCTIONS\n        function openShareModal(url, title, e) {\n            currentShareUrl = url;\n            currentShareTitle = title;\n            document.getElementById('shareLinkInput').value = url;\n            document.getElementById('shareModal').classList.add('open');\n            document.getElementById('modalOverlay').style.display = 'block';\n        }\n        function closeShareModal() {\n            document.getElementById('shareModal').classList.remove('open');\n            document.getElementById('modalOverlay').style.display = 'none';\n        }\n        function copyShareLink() {\n            const input = document.getElementById('shareLinkInput');\n            if (!input) return;\n\n            input.select();\n            // Best Practices: Modern clipboard API with fallback\n            if (navigator.clipboard && navigator.clipboard.writeText) {\n                navigator.clipboard.writeText(input.value)\n                    .then(() => {\n                        showToast('Bağlantı kopyalandı!');\n                    })\n                    .catch(() => {\n                        document.execCommand('copy');\n                        showToast('Bağlantı kopyalandı!');\n                    });\n            } else {\n                document.execCommand('copy');\n                showToast('Bağlantı kopyalandı!');\n            }\n        }\n        function shareTo(p) {\n            const u = encodeURIComponent(currentShareUrl);\n            const t = encodeURIComponent(currentShareTitle);\n            let link = '';\n            if (p === 'wa') link = `https://wa.me/?text=${t}%20${u}`;\n            else if (p === 'tg') link = `https://t.me/share/url?url=${u}&text=${t}`;\n            else if (p === 'fb') link = `https://www.facebook.com/sharer/sharer.php?u=${u}`;\n            else if (p === 'tw') link = `https://twitter.com/intent/tweet?url=${u}&text=${t}`;\n            // window.open() yerine in-page link açma (pop-up blocker'a takılmaz)\n            if (link) {\n                const a = document.createElement('a');\n                a.href = link;\n                a.target = '_blank';\n                a.rel = 'noopener noreferrer';\n                a.style.display = 'none';\n                document.body.appendChild(a);\n                a.click();\n                setTimeout(() => document.body.removeChild(a), 100);\n            }\n        }\n\n        async function toggleLike(vid, btn, e) {\n            const res = await fetch('https://dramadizilerim.com/likes/toggle', {\n                method: 'POST', headers: {\n                    'Content-Type': 'application/json',\n                    'X-CSRF-Token': csrfToken\n                }, body: JSON.stringify({ video_id: vid })\n            });\n            const data = await res.json();\n            if (data.status === 'success') btn.classList.toggle('active');\n            else location.href = 'https://dramadizilerim.com/login';\n        }\n        async function toggleWatchlist(vid, btn, e) {\n            activeVideoId = vid;\n            activeWatchlistBtn = btn;\n            openPlaylistDrawer();\n        }\n\n        function openPlaylistDrawer() {\n            // Check active lists for this video and check the checkmarks\n            const items = document.querySelectorAll('.playlist-item');\n            items.forEach(item => {\n                const listId = parseInt(item.getAttribute('data-list-id') || '0');\n                const icon = item.querySelector('.status-icon');\n                \n                if (listId === 0) {\n                    // Default watchlist\n                    const isListed = userWatchlistIds.includes(activeVideoId);\n                    item.classList.toggle('active', isListed);\n                    if (icon) {\n                        icon.className = isListed ? 'fas fa-check-circle status-icon' : 'far fa-circle status-icon';\n                    }\n                } else {\n                    // Custom user list\n                    const listItems = userListItems[listId] || [];\n                    const isListed = listItems.includes(activeVideoId);\n                    item.classList.toggle('active', isListed);\n                    if (icon) {\n                        icon.className = isListed ? 'fas fa-check-circle status-icon' : 'far fa-circle status-icon';\n                    }\n                }\n            });\n\n            document.getElementById('playlistDrawer').classList.add('open');\n            document.getElementById('playlistOverlay').classList.add('open');\n        }\n\n        function closePlaylistDrawer() {\n            document.getElementById('playlistDrawer').classList.remove('open');\n            document.getElementById('playlistOverlay').classList.remove('open');\n        }\n\n        async function toggleListItem(listId, vid, element) {\n            const icon = element.querySelector('.status-icon');\n            const isActive = element.classList.contains('active');\n            \n            if (listId === 0) {\n                // Default watchlist toggle\n                const res = await fetch('https://dramadizilerim.com/watchlist/toggle', {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application/json',\n                        'X-CSRF-Token': csrfToken\n                    },\n                    body: JSON.stringify({ video_id: vid })\n                });\n                const data = await res.json();\n                \n                if (data.status === 'success') {\n                    const isAdded = data.action === 'added';\n                    element.classList.toggle('active', isAdded);\n                    if (icon) {\n                        icon.className = isAdded ? 'fas fa-check-circle status-icon' : 'far fa-circle status-icon';\n                    }\n                    if (isYouTube || isVimeo) {\n                        ifrm.src = slide.dataset.url;\n                    } else {\n                        // Build token for secure embed, append v=2 to bust aggressive browser cache\n                        ifrm.src = \"https://dramadizilerim.com/embed.php?token=\" + encodeURIComponent(slide.dataset.token) + \"&v=2\";\n                    }\n                    \n                    // Sync active local state array\n                    if (isAdded) {\n                        if (!userWatchlistIds.includes(vid)) userWatchlistIds.push(vid);\n                    } else {\n                        userWatchlistIds = userWatchlistIds.filter(id => id !== vid);\n                    }\n                    \n                    // Sidebar icon active state sync\n                    if (activeWatchlistBtn) {\n                        activeWatchlistBtn.classList.toggle('active', userWatchlistIds.includes(vid));\n                    }\n                    \n                    showToast(data.message || (isAdded ? 'Listeye eklendi' : 'Listeden çıkarıldı'));\n                } else {\n                    location.href = 'https://dramadizilerim.com/login';\n                }\n            } else {\n                // Custom user list toggle\n                const res = await fetch('https://dramadizilerim.com/profile/lists/toggle-item', {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application/json',\n                        'X-CSRF-Token': csrfToken\n                    },\n                    body: JSON.stringify({ list_id: listId, video_id: vid })\n                });\n                const data = await res.json();\n                \n                if (data.status === 'success') {\n                    const isAdded = data.action === 'added';\n                    element.classList.toggle('active', isAdded);\n                    if (icon) {\n                        icon.className = isAdded ? 'fas fa-check-circle status-icon' : 'far fa-circle status-icon';\n                    }\n                    \n                    // Sync local state array\n                    if (!userListItems[listId]) userListItems[listId] = [];\n                    if (isAdded) {\n                        if (!userListItems[listId].includes(vid)) userListItems[listId].push(vid);\n                    } else {\n                        userListItems[listId] = userListItems[listId].filter(id => id !== vid);\n                    }\n                    \n                    // Sidebar icon active state sync (active if in watchlist OR any custom list)\n                    const inWatchlist = userWatchlistIds.includes(vid);\n                    let inAnyCustomList = false;\n                    for (const lId in userListItems) {\n                        if (userListItems[lId].includes(vid)) {\n                            inAnyCustomList = true;\n                            break;\n                        }\n                    }\n                    \n                    if (activeWatchlistBtn) {\n                        activeWatchlistBtn.classList.toggle('active', inWatchlist || inAnyCustomList);\n                    }\n                    \n                    showToast(data.message || (isAdded ? 'Listeye eklendi' : 'Listeden çıkarıldı'));\n                } else {\n                    location.href = 'https://dramadizilerim.com/login';\n                }\n            }\n        }\n\n        async function openComments(vid, e) {\n            activeVideoId = vid;\n            document.getElementById('commentDrawer').style.right = '0';\n            const list = document.getElementById('commentList');\n            // list.innerHTML = '<div style=\"color:#fff; text-align:center;\">Yükleniyor...</div>';\n            const res = await fetch(`https://dramadizilerim.com/comments/list/${vid}`);\n            const data = await res.json();\n            if (data.status === 'success') {\n                const nowSec = Math.floor(Date.now() / 1000);\n                list.innerHTML = data.comments.map(c => {\n                    const isUserVip = c.vip_expires_at && (new Date(c.vip_expires_at).getTime() / 1000) > nowSec;\n                    const vipBadge = isUserVip ? '<span class=\"vip-gold-badge\" style=\"background: linear-gradient(135deg, #f1c40f, #f39c12); color: #000; font-size: 10px; font-weight: 900; padding: 2px 6px; border-radius: 4px; margin-left: 8px; text-transform: uppercase; box-shadow: 0 0 8px rgba(241, 196, 15, 0.5); display: inline-block; vertical-align: middle;\">VIP</span>' : '';\n                    return `\n                    <div style=\"margin-bottom:15px; background:rgba(255,255,255,0.05); padding:10px; border-radius:10px;\">\n                        <div style=\"font-weight:700; font-size:0.8rem; color:${isUserVip ? '#f39c12' : 'var(--c-primary)'}; display: flex; align-items: center;\">${c.username} ${vipBadge}</div>\n                        <div style=\"font-size:0.85rem; color:#fff; margin-top: 4px;\">${c.content}</div>\n                    </div>\n                    `;\n                }).join('');\n            }\n        }\n        function closeDrawer() { document.getElementById('commentDrawer').style.right = '-100%'; }\n        async function postComment() {\n            const inp = document.getElementById('commentInput');\n            const btn = document.querySelector('[data-action=\"post-comment\"]');\n            const text = inp.value.trim();\n            if (!text || !activeVideoId) return;\n\n            // Spam Koruması: Butonu pasifleştir ve yükleniyor ikonu koy\n            if (btn) {\n                btn.disabled = true;\n                btn.innerHTML = '<i class=\"fas fa-spinner fa-spin\"></i>';\n            }\n\n            try {\n                const fd = new FormData(); \n                fd.append('content', text); \n                fd.append('video_id', activeVideoId);\n                fd.append('csrf_token', csrfToken);\n                \n                const res = await fetch('https://dramadizilerim.com/comments/add', { method: 'POST', body: fd });\n                \n                let isSuccess = false;\n                try {\n                    const data = await res.json();\n                    if (data && (data.status === 'success' || data.success)) {\n                        isSuccess = true;\n                    }\n                } catch (e) {\n                    // API JSON dönmediyse bile HTTP status 200/OK ise başarılı say\n                    if (res.ok) {\n                        isSuccess = true;\n                    }\n                }\n\n                if (isSuccess) {\n                    inp.value = '';\n                    // Başarı mesajını siyah premium ekranda şık bir Toast bildirimi olarak göster\n                    showToast('Yorumunuz başarıyla gönderildi!', 'fas fa-check-circle');\n                    \n                    // Listeyi hemen güncelle (yeni yorum anında en üstte belirsin)\n                    openComments(activeVideoId);\n                } else {\n                    showToast('Hata: Yorum gönderilemedi.', 'fas fa-exclamation-triangle');\n                }\n            } catch (err) {\n                // Eğer sunucudan cevap alındıysa ama JSON okuma hatası dışındaysa bağlantı hatası göster\n                showToast('Yorum başarıyla iletildi!', 'fas fa-check-circle');\n                inp.value = '';\n                openComments(activeVideoId);\n            } finally {\n                // Butonu eski haline getir\n                if (btn) {\n                    btn.disabled = false;\n                    btn.innerHTML = '<i class=\"fas fa-paper-plane\"></i>';\n                }\n            }\n        }\n\n        // TOAST NOTIFICATION FUNCTION\n        let toastTimer = null;\n        function showToast(message, iconClass = 'fas fa-tachometer-alt') {\n            const toast = document.getElementById('toastNotification');\n            const toastText = document.getElementById('toastText');\n            const toastIcon = document.getElementById('toastIcon');\n\n            if (toast && toastText && toastIcon) {\n                // Clear existing timer\n                if (toastTimer) {\n                    clearTimeout(toastTimer);\n                }\n\n                // Set content\n                toastText.textContent = message;\n                toastIcon.className = toastIcon.className.replace(/fas fa-\\S+/, iconClass);\n                if (!toastIcon.classList.contains('fas')) {\n                    toastIcon.className = iconClass;\n                }\n\n                // Show toast\n                toast.classList.add('show');\n\n                // Auto hide after 2 seconds\n                toastTimer = setTimeout(() => {\n                    toast.classList.remove('show');\n                }, 2000);\n            }\n        }\n\n        // AUTO-PLAY COUNTDOWN FUNCTIONS\n        function startAutoplayCountdown() {\n            state.countdownValue = 2; // COUNT DOWN 2 SECONDS\n            updateCountdownDisplay();\n            state.countdownTimer = setInterval(() => {\n                state.countdownValue--;\n                updateCountdownDisplay();\n\n                if (state.countdownValue <= 0) {\n                    clearInterval(state.countdownTimer);\n                    autoplayNext();\n                }\n            }, 1000);\n        }\n\n        function updateCountdownDisplay() {\n            const timerEl = document.getElementById('autoplayTimer');\n            const overlay = document.getElementById('autoplayCountdown');\n            if (timerEl) timerEl.textContent = state.countdownValue;\n            if (overlay) {\n                if (state.countdownValue <= 5) {\n                    overlay.classList.add('active');\n                } else {\n                    overlay.classList.remove('active');\n                }\n            }\n        }\n\n        function cancelAutoplayCountdown() {\n            if (state.countdownTimer) {\n                clearInterval(state.countdownTimer);\n                state.countdownTimer = null;\n            }\n            const overlay = document.getElementById('autoplayCountdown');\n            if (overlay) overlay.classList.remove('active');\n        }\n\n        // Modified to trigger the countdown appropriately and keep smooth transitions\n        function autoplayNext() {\n            cancelAutoplayCountdown();\n            goTo(state.index + 1);\n        }\n\n        // Unmute Indicator Click Handler (Synchronously restores volume on direct gesture)\n        document.getElementById('unmuteIndicator').addEventListener('click', function(e) {\n            e.stopPropagation();\n            try {\n                const activeSlide = document.querySelector('.v-slide[data-index=\"' + state.index + '\"]');\n                const iframe = activeSlide ? activeSlide.querySelector('iframe') : null;\n                if (iframe) {\n                    let success = false;\n                    try {\n                        if (iframe.contentDocument) {\n                            const nativeVideo = iframe.contentDocument.querySelector('video');\n                            if (nativeVideo) {\n                                nativeVideo.muted = false;\n                                success = true;\n                            }\n                        }\n                    } catch (err) {}\n                    \n                    if (!success) {\n                        iframe.contentWindow.postMessage({ type: 'unmute' }, '*');\n                    }\n                }\n            } catch (err) {}\n            this.style.display = 'none';\n        });\n\n        // Listen for video end events from iframe\n        window.addEventListener('message', (event) => {\n            const data = event.data;\n\n            // Handle object messages for notifications\n            if (typeof data === 'object') {\n                if (data.type === 'playbackRateChanged') {\n                    const rate = data.rate || 1.0;\n                    // Update ALL display texts (sync with iframe)\n                    document.querySelectorAll('.rate-text').forEach(el => {\n                        el.textContent = rate + 'x';\n                    });\n                }\n                // Note: Toast notifications are now shown locally in cyclePlaybackRate\n            }\n\n            if (data === 'videoEnded' && state.autoPlayNext) {\n                // Directly auto-play next video without countdown overlay\n                if (state.index < state.total - 1) { // Not the last video\n                    autoplayNext();\n                }\n            }\n\n            if (data === 'videoPlaying') {\n                // Video started playing, cancel any countdown\n                cancelAutoplayCountdown();\n                // Remove paused class from current player\n                const currentPlayer = document.querySelector('.v-slide[data-index=\"' + state.index + '\"] .player-wrap');\n                if (currentPlayer) currentPlayer.classList.remove('paused');\n            }\n\n            if (data === 'videoAutoplayBlocked') {\n                const indicator = document.getElementById('unmuteIndicator');\n                if (indicator) {\n                    indicator.style.display = 'flex';\n                    indicator.style.opacity = '1';\n                }\n            }\n\n            // Handle play/pause for iframe\n            if (data === 'play' || data === 'pause') {\n                const iframe = document.querySelector('.v-slide[data-index=\"' + state.index + '\"] iframe');\n                if (iframe && iframe.contentWindow) {\n                    try {\n                        iframe.contentWindow.postMessage(data, '*');\n                    } catch (e) {\n                        // Cross-origin error, ignore\n                    }\n                }\n            }\n        });\n    </script>\n\n    <!-- AD & IMPRESSION ENGINE -->\n    <script type=\"a6f0efca0c24a2e4b88d0c8d-text/javascript\">\n        function logAdImpression() {\n            fetch('https://dramadizilerim.com/api/log-ad-click', { method: 'POST' }).catch(() => { });\n        }\n\n        let playerAdTriggered = false;\n\n        function triggerAds() {\n            const activeSlide = document.querySelector('.v-slide[data-index=\"' + state.index + '\"]');\n            if (!activeSlide) return;\n\n            const episodeNum = parseInt(activeSlide.dataset.episode || '1');\n\n            if (episodeNum === 1 || (typeof window.isAdUnlocked === 'function' && !window.isAdUnlocked())) {\n                logAdImpression();\n\n                                if (!playerAdTriggered) {\n                    playerAdTriggered = true;\n                                        try {\n                        (function () {\n                            (function(s){s.dataset.zone='10460279',s.src='https://al5sm.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))                        })();\n                    } catch(e) { console.error(\"Ad Script Error:\", e); }\n                }\n                            }\n        }\n\n        window.addEventListener('load', function() {\n            const activeSlide = document.querySelector('.v-slide[data-index=\"' + 0 + '\"]');\n            if (activeSlide) {\n                const ep = parseInt(activeSlide.dataset.episode || '1');\n                if (ep === 1 || (typeof window.isAdUnlocked === 'function' && !window.isAdUnlocked())) {\n                    logAdImpression();\n                }\n            }\n        });\n\n        // Tüm sayfaya tıklanma event'i (player butonu dışında da çalışması için)\n        document.addEventListener('click', function () {\n            triggerAds();\n        }, { once: true, capture: true });\n    </script>\n\n            <!-- Global Ad Script - Sayfa açılır açılmaz reklam script'ini yükle -->\n        <script type=\"a6f0efca0c24a2e4b88d0c8d-text/javascript\">\n            (function () {\n                if (typeof window.isAdUnlocked === 'function' && window.isAdUnlocked()) {\n                    console.log('[AdShield] Global popup ad script bypassed - already unlocked.');\n                    return;\n                }\n                var s = document.createElement('script');\n                s.dataset.zone = '10460279';\n                s.src = 'https://al5sm.com/tag.min.js';\n                document.body.appendChild(s);\n            })();\n        </script>\n\n        <!-- GLOBAL AD CODES -->\n            \n    <!-- Playlist Selection Drawer -->\n    <div class=\"playlist-overlay\" id=\"playlistOverlay\" onclick=\"if (!window.__cfRLUnblockHandlers) return false; closePlaylistDrawer()\" data-cf-modified-a6f0efca0c24a2e4b88d0c8d-=\"\"></div>\n    <div class=\"playlist-drawer\" id=\"playlistDrawer\">\n        <div class=\"drawer-close-btn\" onclick=\"if (!window.__cfRLUnblockHandlers) return false; closePlaylistDrawer()\" data-cf-modified-a6f0efca0c24a2e4b88d0c8d-=\"\">\n            <i class=\"fas fa-times\"></i>\n        </div>\n        <h3><i class=\"fas fa-list-ul\"></i> Listelerime Ekle</h3>\n        \n        <div class=\"playlist-items\">\n            <!-- Ana İzleme Listesi -->\n            <div class=\"playlist-item\" onclick=\"if (!window.__cfRLUnblockHandlers) return false; toggleListItem(0, activeVideoId, this)\" id=\"playlist-item-0\" data-cf-modified-a6f0efca0c24a2e4b88d0c8d-=\"\">\n                <span class=\"list-name\">İzleme Listesi (Varsayılan)</span>\n                <i class=\"fas fa-check-circle status-icon\"></i>\n            </div>\n\n            <!-- Kullanıcı Özel Listeleri -->\n                            <div style=\"padding: 10px; color: rgba(255,255,255,0.4); font-size: 0.85rem; text-align: center; border: 1px dashed rgba(255,255,255,0.1); border-radius: 8px;\">\n                    Özel bir listeniz bulunmuyor.\n                </div>\n                    </div>\n\n        <div style=\"margin-top: 20px; text-align: center;\">\n            <a href=\"https://dramadizilerim.com/profile\" style=\"color: #e50914; text-decoration: none; font-size: 0.9rem; font-weight: 600;\">\n                <i class=\"fas fa-plus\"></i> Yeni Liste Oluştur\n            </a>\n        </div>\n    </div>\n    </main>\n\n    <!-- GLOBAL VARIABLES FOR JS -->\n    <script type=\"a6f0efca0c24a2e4b88d0c8d-text/javascript\">\n        let activeWatchlistBtn = null;\n        let userWatchlistIds = [];\n        let userListItems = [];\n\n        // Initialize active states for items when drawer opens could be done via JS\n        // But for sync simplicity, we'll use a dynamic approach in open function later or just keep PHP simple.\n    </script>\n<script src=\"/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js\" data-cf-settings=\"a6f0efca0c24a2e4b88d0c8d-|49\" defer></script><script defer src=\"https:/