          "cookies": [],
          "content": {
            "size": 2169,
            "mimeType": "text/vtt",
            "text": "WEBVTT\n\n00:00:01.006 --> 00:00:02.100\nKadınlar Hapishanesi\n\n00:00:02.200 --> 00:00:05.300\nKadınımın banyo yaptığını gözetlemeye mi\ncüret ettin?\n\n00:00:04.523 --> 00:00:04.943\nSong Ni\nSong Ailesinin Kızı\n\n00:00:05.000 --> 00:00:06.400\nXiao Yu\nXiao Ailesinin Beyefendisi\n\n00:00:05.300 --> 00:00:07.400\nOldukça cesurmuşsun ha.\n\n00:00:07.400 --> 00:00:09.600\nMadem bu kadar heyecanlısın\n\n00:00:09.900 --> 00:00:11.466\nseni memnun edeyim.\n\n00:00:18.584 --> 00:00:20.216\nAh, bir erkek istiyorum!\n\n00:00:20.500 --> 00:00:21.400\nBu kadınlar\n\n00:00:22.133 --> 00:00:26.333\nen az 3 yıldır erkek yüzü görmemiş.\n\n00:00:26.333 --> 00:00:29.300\nİyi eğlen, hadi gidelim!\n\n00:00:29.559 --> 00:00:30.764\nHayır!\n\n00:00:30.912 --> 00:00:31.654\nYürü!\n\n00:00:32.388 --> 00:00:35.510\nHayır, lütfen hayır!\n\n00:00:36.833 --> 00:00:37.633\nHadi hadi hadi!\n\n00:00:46.100 --> 00:00:47.266\nDur dur!\n\n00:00:48.133 --> 00:00:49.233\nArtık dayanamıyorum.\n\n00:00:49.233 --> 00:00:50.266\nSorun değil.\n\n00:00:50.866 --> 00:00:53.933\nBüyük Doğu Okyanusu'nun hazırladığı özel\nilaçlarım var.\n\n00:00:53.933 --> 00:00:57.533\nHa ha ha!\n\n00:01:07.133 --> 00:01:12.533\n-Ahhh!\n-Hadi hadi, devam!\n\n00:01:12.533 --> 00:01:13.333\nXiao Yu...\n\n00:01:14.033 --> 00:01:14.633\nBu hayatta\n\n00:01:14.633 --> 00:01:16.700\nsadece güçsüz ve etkisiz bir\n\n00:01:16.700 --> 00:01:19.500\nkurye oldum. Ama bir sonraki hayatta\n\n00:01:20.100 --> 00:01:22.833\nsana yaptıklarını mutlaka geri öderim.\n\n00:01:36.933 --> 00:01:38.466\nXiao Ailesinin Düğün Odası\n\n00:01:36.933 --> 00:01:38.466\nAğabey, oksijen maskesini çek üstünden.\n\n00:01:38.466 --> 00:01:41.733\nNeden bu kadar yavaş?\n\n00:01:47.433 --> 00:01:49.300\nXiao Wang\nXiao Ailesinin İkinci Oğlu\n\n00:01:47.433 --> 00:01:49.300\nOn yıl öncesine geri döndüm.\n\n00:01:49.666 --> 00:01:51.500\nDüşmanım Xiao Yu'nun kardeşi olarak\nyeniden doğdum.\n\n00:01:51.700 --> 00:01:54.533\nXiao Yu, seninle hesaplaşacağım!\n\n00:01:55.633 --> 00:02:00.866\nSeni mahvedeceğim, seni!\n\n00:02:00.866 --> 00:02:03.266\nHa ha!\n\n00:02:09.120 --> 00:02:10.541\nAşağılık!\n\n00:02:13.633 --> 00:02:15.866\nBu hayatta hepinizi mahvedeceğim."
          },
          "redirectURL": "",
