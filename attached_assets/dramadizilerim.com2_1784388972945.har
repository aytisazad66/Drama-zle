          "content": {
            "size": 17842,
            "mimeType": "text/css",
            "text": "/**\n * Accessibility (WCAG 2.1 Level AA) Styles\n * \n * This file contains all accessibility-related styles including:\n * - Skip links for keyboard navigation\n * - Visually hidden class for screen readers\n * - Focus visible indicators\n * - Reduced motion support\n */\n\n/* ============================================\n   SKIP LINKS (WCAG 2.4.1)\n   ============================================ */\n\n.skip-link {\n    position: absolute;\n    top: -40px;\n    left: 0;\n    background: #e50914;\n    color: #fff;\n    padding: 8px 16px;\n    text-decoration: none;\n    font-weight: 600;\n    z-index: 99999;\n    transition: top 0.3s ease;\n}\n\n.skip-link:focus {\n    top: 0;\n    left: 0;\n    outline: 2px solid #fff;\n    outline-offset: -2px;\n}\n\n/* ============================================\n   VISUALLY HIDDEN (Screen Reader Only)\n   WCAG 2.1.1 - Text Alternatives\n   ============================================ */\n\n.sr-only,\n.visually-hidden {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n}\n\n/* Make visible when focused */\n.visually-hidden:focus,\n.sr-only:focus {\n    position: static;\n    width: auto;\n    height: auto;\n    padding: inherit;\n    margin: inherit;\n    overflow: visible;\n    clip: auto;\n    white-space: normal;\n}\n\n/* ============================================\n   FOCUS INDICATORS (WCAG 2.4.7)\n   ============================================ */\n\n/* Remove default outline for mouse users */\n:focus {\n    outline: none;\n}\n\n/* Add visible focus for keyboard users */\n:focus-visible {\n    outline: 2px solid #e50914;\n    outline-offset: 2px;\n}\n\n/* Button focus styles */\nbutton:focus-visible,\na:focus-visible,\ninput:focus-visible,\ntextarea:focus-visible,\nselect:focus-visible {\n    outline: 2px solid #e50914;\n    outline-offset: 2px;\n    box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.2);\n}\n\n/* ============================================\n   REDUCED MOTION (WCAG 2.3.3)\n   ============================================ */\n\n@media (prefers-reduced-motion: reduce) {\n\n    *,\n    *::before,\n    *::after {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n        scroll-behavior: auto !important;\n    }\n}\n\n/* ============================================\n   HIGH CONTRAST MODE SUPPORT\n   ============================================ */\n\n@media (prefers-contrast: high) {\n\n    a,\n    button,\n    input,\n    textarea,\n    select {\n        border: 2px solid currentColor;\n    }\n}\n\n/* ============================================\n   LANDMARK REGIONS\n   ============================================ */\n\n[role=\"banner\"],\n[role=\"navigation\"],\n[role=\"main\"],\n[role=\"contentinfo\"],\n[role=\"complementary\"],\n[role=\"search\"] {\n    position: relative;\n}\n\n/* ============================================\n   SKIP TO NAVIGATION\n   ============================================ */\n\n.skip-to-nav {\n    position: absolute;\n    top: -40px;\n    left: 0;\n    background: #e50914;\n    color: #fff;\n    padding: 8px 16px;\n    text-decoration: none;\n    font-weight: 600;\n    z-index: 99999;\n}\n\n.skip-to-nav:focus {\n    top: 40px;\n}\n\n/* ============================================\n   LIVE REGIONS (ARIA)\n   ============================================ */\n\n[aria-live=\"polite\"],\n[aria-live=\"assertive\"] {\n    position: relative;\n}\n\n/* ============================================\n   FOCUS TRAP FOR MODALS\n   ============================================ */\n\n.focus-trap {\n    position: relative;\n}\n\n.focus-trap::before,\n.focus-trap::after {\n    content: '';\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n}\n\n/* ============================================\n   HEADING ANCHOR LINKS\n   ============================================ */\n\n.heading-anchor {\n    margin-left: 0.5em;\n    opacity: 0;\n    transition: opacity 0.2s ease;\n}\n\nh1:hover .heading-anchor,\nh2:hover .heading-anchor,\nh3:hover .heading-anchor,\nh4:hover .heading-anchor,\nh5:hover .heading-anchor,\nh6:hover .heading-anchor {\n    opacity: 1;\n}\n\n/* ============================================\n   COLOR CONTRAST HELPERS\n   ============================================ */\n\n.text-contrast-high {\n    color: #fff;\n}\n\n.text-contrast-medium {\n    color: #f1f5f9;\n}\n\n.text-contrast-muted {\n    color: #94a3b8;\n}\n\n/* ============================================\n   ACCESSIBLE FORM STYLES\n   ============================================ */\n\n.form-group {\n    margin-bottom: 1.5rem;\n}\n\n.form-label {\n    display: block;\n    margin-bottom: 0.5rem;\n    font-weight: 600;\n    color: #f1f5f9;\n}\n\n.form-error {\n    display: block;\n    margin-top: 0.25rem;\n    color: #ef4444;\n    font-size: 0.875rem;\n}\n\n.form-hint {\n    display: block;\n    margin-top: 0.25rem;\n    color: #94a3b8;\n    font-size: 0.875rem;\n}\n\n/* ============================================\n   ACCESSIBLE TABLE STYLES\n   ============================================ */\n\n.accessible-table {\n    border-collapse: collapse;\n    width: 100%;\n}\n\n.accessible-table caption {\n    text-align: left;\n    padding: 0.5rem;\n    font-weight: 600;\n    color: #f1f5f9;\n}\n\n.accessible-table th,\n.accessible-table td {\n    padding: 0.75rem;\n    border: 1px solid #334155;\n    text-align: left;\n}\n\n.accessible-table th {\n    background-color: #1e293b;\n    font-weight: 600;\n}\n\n/* ============================================\n   ACCESSIBLE BUTTON STYLES\n   ============================================ */\n\n.btn-icon-only {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 44px;\n    min-height: 44px;\n    padding: 0.5rem;\n}\n\n/* ============================================\n   ACCESSIBLE VIDEO CONTROLS\n   ============================================ */\n\n.video-controls {\n    position: relative;\n    z-index: 10;\n}\n\n.video-controls button {\n    min-width: 44px;\n    min-height: 44px;\n}\n\n/* ============================================\n   ACCESSIBLE CAROUSEL/SLIDER\n   ============================================ */\n\n.carousel-controls {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n}\n\n.carousel-button {\n    min-width: 44px;\n    min-height: 44px;\n    border-radius: 50%;\n    background: #e50914;\n    color: #fff;\n    border: none;\n    cursor: pointer;\n    transition: background-color 0.2s ease;\n}\n\n.carousel-button:hover {\n    background: #ff0f1f;\n}\n\n.carousel-button:disabled {\n    background: #475569;\n    cursor: not-allowed;\n}\n\n/* ============================================\n   ACCESSIBLE TOOLTIPS\n   ============================================ */\n\n[data-tooltip] {\n    position: relative;\n}\n\n[data-tooltip]::after {\n    content: attr(data-tooltip);\n    position: absolute;\n    bottom: 100%;\n    left: 50%;\n    transform: translateX(-50%);\n    padding: 0.5rem;\n    background: #1e293b;\n    color: #f1f5f9;\n    font-size: 0.875rem;\n    white-space: nowrap;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.2s ease;\n    z-index: 100;\n}\n\n[data-tooltip]:hover::after,\n[data-tooltip]:focus::after {\n    opacity: 1;\n}\n\n/* ============================================\n   ACCESSIBLE ACCORDION\n   ============================================ */\n\n.accordion-button {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    width: 100%;\n    padding: 1rem;\n    background: #1e293b;\n    color: #f1f5f9;\n    border: none;\n    cursor: pointer;\n    text-align: left;\n    font-size: 1rem;\n    font-weight: 600;\n}\n\n.accordion-button:hover {\n    background: #334155;\n}\n\n.accordion-button[aria-expanded=\"true\"] .accordion-icon {\n    transform: rotate(180deg);\n}\n\n.accordion-icon {\n    transition: transform 0.2s ease;\n}\n\n.accordion-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease;\n}\n\n.accordion-content[aria-hidden=\"false\"] {\n    max-height: 1000px;\n}\n\n/* ============================================\n   ACCESSIBLE TABS\n   ============================================ */\n\n.tab-list {\n    display: flex;\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    border-bottom: 2px solid #334155;\n}\n\n.tab-button {\n    padding: 0.75rem 1.5rem;\n    background: transparent;\n    color: #94a3b8;\n    border: none;\n    border-bottom: 2px solid transparent;\n    cursor: pointer;\n    font-size: 1rem;\n    font-weight: 600;\n    margin-bottom: -2px;\n}\n\n.tab-button:hover {\n    color: #f1f5f9;\n}\n\n.tab-button[aria-selected=\"true\"] {\n    color: #e50914;\n    border-bottom-color: #e50914;\n}\n\n.tab-panel {\n    padding: 1.5rem 0;\n}\n\n.tab-panel[aria-hidden=\"true\"] {\n    display: none;\n}\n\n/* ============================================\n   ACCESSIBLE MODAL\n   ============================================ */\n\n.modal-overlay {\n    position: fixed;\n    inset: 0;\n    background: rgba(0, 0, 0, 0.8);\n    z-index: 9999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.modal-content {\n    background: #1e293b;\n    color: #f1f5f9;\n    padding: 2rem;\n    border-radius: 0.5rem;\n    max-width: 90%;\n    width: 500px;\n    max-height: 90vh;\n    overflow-y: auto;\n}\n\n.modal-close {\n    position: absolute;\n    top: 1rem;\n    right: 1rem;\n    min-width: 44px;\n    min-height: 44px;\n    background: transparent;\n    color: #f1f5f9;\n    border: none;\n    cursor: pointer;\n    font-size: 1.5rem;\n}\n\n.modal-close:hover {\n    color: #e50914;\n}\n\n/* ============================================\n   ACCESSIBLE PROGRESS BAR\n   ============================================ */\n\n.progress-bar {\n    width: 100%;\n    height: 0.5rem;\n    background: #334155;\n    border-radius: 0.25rem;\n    overflow: hidden;\n}\n\n.progress-fill {\n    height: 100%;\n    background: #e50914;\n    transition: width 0.3s ease;\n}\n\n/* ============================================\n   ACCESSIBLE ALERTS\n   ============================================ */\n\n.alert {\n    padding: 1rem;\n    border-radius: 0.5rem;\n    margin-bottom: 1rem;\n}\n\n.alert-success {\n    background: #064e3b;\n    color: #6ee7b7;\n    border: 1px solid #059669;\n}\n\n.alert-error {\n    background: #7f1d1d;\n    color: #fca5a5;\n    border: 1px solid #dc2626;\n}\n\n.alert-warning {\n    background: #78350f;\n    color: #fcd34d;\n    border: 1px solid #d97706;\n}\n\n.alert-info {\n    background: #1e3a8a;\n    color: #93c5fd;\n    border: 1px solid #2563eb;\n}\n\n/* ============================================\n   ACCESSIBLE BREADCRUMBS\n   ============================================ */\n\n.breadcrumb {\n    display: flex;\n    flex-wrap: wrap;\n    list-style: none;\n    margin: 0;\n    padding: 0.5rem 0;\n}\n\n.breadcrumb-item {\n    display: flex;\n    align-items: center;\n}\n\n.breadcrumb-item:not(:last-child)::after {\n    content: '/';\n    margin: 0 0.5rem;\n    color: #94a3b8;\n}\n\n.breadcrumb-item a {\n    color: #94a3b8;\n    text-decoration: none;\n}\n\n.breadcrumb-item a:hover {\n    color: #e50914;\n}\n\n.breadcrumb-item[aria-current=\"page\"] {\n    color: #f1f5f9;\n    font-weight: 600;\n}\n\n/* ============================================\n   ACCESSIBLE SEARCH\n   ============================================ */\n\n.search-form {\n    display: flex;\n    gap: 0.5rem;\n}\n\n.search-form .search-input {\n    flex: 1;\n    padding: 0.75rem;\n    background: #333333;\n    color: #f1f5f9;\n    border: 2px solid #334155;\n    border-radius: 0.5rem;\n    font-size: 1rem;\n}\n\n.search-form .search-input:focus {\n    border-color: #e50914;\n    outline: none;\n}\n\n.search-button {\n    padding: 0.75rem 1.5rem;\n    background: #e50914;\n    color: #fff;\n    border: none;\n    border-radius: 0.5rem;\n    cursor: pointer;\n    font-weight: 600;\n}\n\n.search-button:hover {\n    background: #ff0f1f;\n}\n\n/* ============================================\n   ACCESSIBLE PAGINATION\n   ============================================ */\n\n.pagination {\n    display: flex;\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    gap: 0.5rem;\n}\n\n.pagination-item a,\n.pagination-item span {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 44px;\n    min-height: 44px;\n    padding: 0.5rem 1rem;\n    background: #1e293b;\n    color: #f1f5f9;\n    text-decoration: none;\n    border-radius: 0.5rem;\n    font-weight: 600;\n}\n\n.pagination-item a:hover {\n    background: #334155;\n}\n\n.pagination-item[aria-current=\"page\"] span {\n    background: #e50914;\n    color: #fff;\n}\n\n/* ============================================\n   ACCESSIBLE CARD LINKS\n   ============================================ */\n\n.card-link {\n    position: relative;\n    display: block;\n    text-decoration: none;\n    color: inherit;\n}\n\n.card-link::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n}\n\n/* ============================================\n   ACCESSIBLE DROPDOWN\n   ============================================ */\n\n.dropdown {\n    position: relative;\n}\n\n.dropdown-button {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.75rem 1rem;\n    background: #1e293b;\n    color: #f1f5f9;\n    border: 2px solid #334155;\n    border-radius: 0.5rem;\n    cursor: pointer;\n    font-size: 1rem;\n    font-weight: 600;\n}\n\n.dropdown-button:hover {\n    background: #334155;\n}\n\n.dropdown-menu {\n    position: absolute;\n    top: 100%;\n    left: 0;\n    min-width: 200px;\n    background: #1e293b;\n    border: 2px solid #334155;\n    border-radius: 0.5rem;\n    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);\n    z-index: 100;\n    opacity: 0;\n    visibility: hidden;\n    transform: translateY(-10px);\n    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;\n}\n\n.dropdown-menu[aria-hidden=\"false\"] {\n    opacity: 1;\n    visibility: visible;\n    transform: translateY(0);\n}\n\n.dropdown-item {\n    display: block;\n    padding: 0.75rem 1rem;\n    color: #f1f5f9;\n    text-decoration: none;\n}\n\n.dropdown-item:hover {\n    background: #334155;\n}\n\n/* ============================================\n   ACCESSIBLE TOGGLE SWITCH\n   ============================================ */\n\n.toggle-switch {\n    position: relative;\n    display: inline-block;\n    width: 52px;\n    height: 28px;\n}\n\n.toggle-switch input {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n}\n\n.toggle-slider {\n    position: absolute;\n    inset: 0;\n    background: #475569;\n    border-radius: 28px;\n    cursor: pointer;\n    transition: background 0.2s ease;\n}\n\n.toggle-slider::before {\n    content: '';\n    position: absolute;\n    top: 2px;\n    left: 2px;\n    width: 24px;\n    height: 24px;\n    background: #fff;\n    border-radius: 50%;\n    transition: transform 0.2s ease;\n}\n\n.toggle-switch input:checked+.toggle-slider {\n    background: #e50914;\n}\n\n.toggle-switch input:checked+.toggle-slider::before {\n    transform: translateX(24px);\n}\n\n.toggle-switch input:focus+.toggle-slider {\n    box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.3);\n}\n\n/* ============================================\n   ACCESSIBLE RATING STARS\n   ============================================ */\n\n.rating {\n    display: inline-flex;\n    gap: 0.25rem;\n}\n\n.rating-star {\n    width: 24px;\n    height: 24px;\n    color: #475569;\n}\n\n.rating-star.filled {\n    color: #fbbf24;\n}\n\n.rating-star.half {\n    background: linear-gradient(90deg, #fbbf24 50%, #475569 50%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n/* ============================================\n   ACCESSIBLE BADGE\n   ============================================ */\n\n.badge {\n    display: inline-flex;\n    align-items: center;\n    padding: 0.25rem 0.75rem;\n    font-size: 0.875rem;\n    font-weight: 600;\n    border-radius: 9999px;\n}\n\n.badge-primary {\n    background: #e50914;\n    color: #fff;\n}\n\n.badge-secondary {\n    background: #475569;\n    color: #fff;\n}\n\n.badge-success {\n    background: #059669;\n    color: #fff;\n}\n\n.badge-warning {\n    background: #d97706;\n    color: #fff;\n}\n\n.badge-error {\n    background: #dc2626;\n    color: #fff;\n}\n\n/* ============================================\n   ACCESSIBLE AVATAR\n   ============================================ */\n\n.avatar {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: #334155;\n    color: #f1f5f9;\n    font-weight: 600;\n    overflow: hidden;\n}\n\n.avatar img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n}\n\n.avatar-sm {\n    width: 32px;\n    height: 32px;\n}\n\n.avatar-lg {\n    width: 56px;\n    height: 56px;\n}\n\n.avatar-xl {\n    width: 80px;\n    height: 80px;\n}\n\n/* ============================================\n   ACCESSIBLE SKELETON LOADING\n   ============================================ */\n\n.skeleton {\n    background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);\n    background-size: 200% 100%;\n    animation: skeleton-loading 1.5s ease-in-out infinite;\n}\n\n@keyframes skeleton-loading {\n    0% {\n        background-position: 200% 0;\n    }\n\n    100% {\n        background-position: -200% 0;\n    }\n}\n\n/* ============================================\n   ACCESSIBLE NOTIFICATION TOAST\n   ============================================ */\n\n.toast {\n    position: fixed;\n    bottom: 2rem;\n    right: 2rem;\n    min-width: 300px;\n    max-width: 500px;\n    padding: 1rem;\n    background: #1e293b;\n    color: #f1f5f9;\n    border-radius: 0.5rem;\n    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);\n    z-index: 9999;\n    transform: translateX(120%);\n    transition: transform 0.3s ease;\n}\n\n.toast.show {\n    transform: translateX(0);\n}\n\n.toast-close {\n    position: absolute;\n    top: 0.5rem;\n    right: 0.5rem;\n    min-width: 32px;\n    min-height: 32px;\n    background: transparent;\n    color: #94a3b8;\n    border: none;\n    cursor: pointer;\n}\n\n.toast-close:hover {\n    color: #f1f5f9;\n}"
