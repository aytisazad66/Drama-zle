            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"tr\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\"\n        content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n    <meta name=\"theme-color\" content=\"#000000\">\n    <!-- Best Practices: Use strict referrer policy for security -->\n    <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\" />\n\n    <!-- Best Practices: Security Meta Tags -->\n    <meta http-equiv=\"X-Content-Type-Options\" content=\"nosniff\">\n\n        <title>YERALTI VARİSİ Sezon 1 Bölüm 1 | DramaDizilerim</title>\n    <meta name=\"description\" content=\"YERALTI VARİSİ 1. Sezon 1. Bölüm full HD izle. Reklamsız ve kesintisiz izleme deneyimi.\">\n    <meta name=\"csrf-token\" content=\"be3dab24322a3c55529d181ff387b29bc3bcff6c1936676c139ada3001922e56\" />        <meta name=\"robots\" content=\"index, follow\">\n    <meta name=\"googlebot\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://dramadizilerim.com/izle/yeralti-vari-si\">\n\n    <!-- Open Graph -->\n    <meta property=\"og:type\" content=\"video.episode\">\n    <meta property=\"og:title\" content=\"YERALTI VARİSİ Sezon 1 Bölüm 1 | DramaDizilerim\">\n    <meta property=\"og:description\" content=\"YERALTI VARİSİ 1. Sezon 1. Bölüm full HD izle. Reklamsız ve kesintisiz izleme deneyimi.\">\n    <meta property=\"og:image\" content=\"https://static-v1.mydramawave.com/vt/prod/cover/c4e45914-a52b-4e89-a7fc-7cafc50ee8f3.jpg?image_process=quality,85/resize,w_600/format,webp\">\n    <meta property=\"og:url\" content=\"https://dramadizilerim.com/izle/yeralti-vari-si\">\n    <meta property=\"og:site_name\" content=\"Drama Dizilerim\">\n\n    <!-- Twitter Card -->\n    <meta name=\"twitter:card\" content=\"player\">\n    <meta name=\"twitter:title\" content=\"YERALTI VARİSİ Sezon 1 Bölüm 1 | DramaDizilerim\">\n    <meta name=\"twitter:description\" content=\"YERALTI VARİSİ 1. Sezon 1. Bölüm full HD izle. Reklamsız ve kesintisiz izleme deneyimi.\">\n    <meta name=\"twitter:image\" content=\"https://static-v1.mydramawave.com/vt/prod/cover/c4e45914-a52b-4e89-a7fc-7cafc50ee8f3.jpg?image_process=quality,85/resize,w_600/format,webp\">\n    <style>\n        /* CRITICAL CSS - Load immediately to prevent FOUC */\n        html,\n        body {\n            margin: 0 !important;\n            padding: 0 !important;\n            width: 100% !important;\n            height: 100% !important;\n            background: #000 !important;\n            overflow: hidden !important;\n            position: fixed !important;\n            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        header,\n        footer,\n        .nav-container,\n        .ads-container,\n        .announcement-bar {\n            display: none !important;\n        }\n    </style>\n\n    <!-- Performance: DNS Prefetch & Preconnect -->\n    <link rel=\"dns-prefetch\" href=\"//cdnjs.cloudflare.com\">\n    <link rel=\"dns-prefetch\" href=\"//fonts.googleapis.com\">\n    <link rel=\"dns-prefetch\" href=\"//fonts.gstatic.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link rel=\"preconnect\" href=\"https://cdnjs.cloudflare.com\" crossorigin>\n\n    <!-- Font Awesome - Non-blocking -->\n    <!-- Best Practices: Subresource Integrity for Font Awesome -->\n    <script src=\"/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js\" data-cf-settings=\"a6f0efca0c24a2e4b88d0c8d-|49\"></script><link rel=\"preload\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" as=\"style\"\n        onload=\"this.onload=null;this.rel='stylesheet'\"\n        integrity=\"sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0\" crossorigin=\"anonymous\">\n    <noscript>\n        <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\"\n            integrity=\"sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0\" crossorigin=\"anonymous\">\n    </noscript>\n\n    <!-- Google Fonts Inter Import with display=swap to prevent FOUT/CLS and avoid 404 font errors -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n    <!-- Accessibility CSS - DEFERRED for better FCP -->\n    <script src=\"/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js\" data-cf-settings=\"a6f0efca0c24a2e4b88d0c8d-|49\"></script><link rel=\"preload\"\n        href=\"https://dramadizilerim.com/assets/css/accessibility.css?v=1784157062\"\n        as=\"style\" onload=\"this.onload=null;this.rel='stylesheet'\">\n    <noscript>\n        <link rel=\"stylesheet\"\n            href=\"https://dramadizilerim.com/assets/css/accessibility.css?v=1784157062\">\n    </noscript>\n</head>\n\n<body>\n    <!-- Skip to main content (WCAG 2.4.1) -->\n    <a href=\"#main-content\" class=\"skip-link\">İçeriğe Atla</a>\n    <!-- AD CONTAINMENT SHIELD: Restricts popup ad networks strictly to the 1st episode using capturing-phase event interceptors -->\n    <script type=\"a6f0efca0c24a2e4b88d0c8d-text/javascript\">\n        (function () {\n            const initialIdx = 0;\n            const seriesId = 1640;\n            const isVip = false;\n            const UNLOCK_DURATION = 30 * 60 * 1000; // 30 minutes in milliseconds\n\n            // Global memory fallback to prevent storage block failures\n            window.adUnlockedCache = window.adUnlockedCache || {};\n\n            /**\n             * Helper: Get the current episode number from the active slide's data-episode attribute.\n             * Returns the integer episode number (e.g. 1, 2, 3...).\n             */\n            function getCurrentEpisodeNum() {\n                const currentIdx = (typeof state !== 'undefined' && state) ? state.index : initialIdx;\n                const activeSlide = document.querySelector('.v-slide[data-index=\"' + currentIdx + '\"]');\n                return activeSlide ? parseInt(activeSlide.dataset.episode || '1') : 1;\n            }\n\n            /**\n             * Check if the series is unlocked by checking cookies or memory\n             */\n            function isAdUnlockedOnly() {\n                if (isVip) return true;\n\n                // 1. Check memory cache\n                if (window.adUnlockedCache[seriesId]) {\n                    const elapsed = Date.now() - window.adUnlockedCache[seriesId];\n                    if (elapsed < UNLOCK_DURATION) {\n                        return true;\n                    }\n                }\n\n                // 2. Check cookies\n                try {\n                    const name = \"ad_unlocked_\" + seriesId + \"=\";\n                    const decodedCookie = decodeURIComponent(document.cookie);\n                    const ca = decodedCookie.split(';');\n                    for (let i = 0; i < ca.length; i++) {\n                        let c = ca[i].trim();\n                        if (c.indexOf(name) === 0) {\n                            // Sync to memory\n                            window.adUnlockedCache[seriesId] = Date.now();\n                            return true;\n                        }\n                    }\n                } catch (e) {\n                    // Ignore cookie read errors\n                }\n\n                // 3. Fallback check localStorage\n                try {\n                    const unlockedAt = localStorage.getItem('ad_unlocked_' + seriesId);\n                    if (unlockedAt) {\n                        const elapsed = Date.now() - parseInt(unlockedAt, 10);\n                        if (elapsed < UNLOCK_DURATION) {\n                            window.adUnlockedCache[seriesId] = parseInt(unlockedAt, 10);\n                            return true;\n                        }\n                    }\n                } catch (e) {\n                    // Ignore localStorage errors\n                }\n                return false;\n            }\n\n            /**\n             * Save ad unlock timestamp in cookie, memory, and localStorage safely\n             */\n            function setAdUnlocked() {\n                const now = Date.now();\n                window.adUnlockedCache[seriesId] = now;\n                try {\n                    // Set cookie for 30 minutes (1800 seconds)\n                    document.cookie = \"ad_unlocked_\" + seriesId + \"=true; max-age=1800; path=/\";\n                } catch (e) {}\n                try {\n                    localStorage.setItem('ad_unlocked_' + seriesId, now);\n                } catch (e) {}\n\n                // If we are on an episode > 1 and the ad script is loaded, reload the page to clear it from memory\n                const showPlayerAdLoaded = false;\n                if (getCurrentEpisodeNum() > 1 && showPlayerAdLoaded) {\n                    const currentIdx = (typeof state !== 'undefined' && state) ? state.index : initialIdx;\n                    const activeSlide = document.querySelector('.v-slide[data-index=\"' + currentIdx + '\"]');\n                    const targetUrl = activeSlide ? activeSlide.dataset.url : window.location.href;\n                    window.location.replace(targetUrl);\n                }\n            }\n\n            /**\n             * Check if ads are unlocked (either because user is VIP, on Ep 1, or watched ad within 1.5 hours)\n             */\n            function isAdUnlocked() {\n                if (getCurrentEpisodeNum() === 1) return true;\n                return isAdUnlockedOnly();\n            }\n\n            // Expose globally\n            window.isAdUnlocked = isAdUnlocked;\n\n            /**\n             * blockAdEvents – capturing-phase handler for click/mousedown/mouseup ONLY.\n             * Does NOT intercept pointer events (pointerdown/pointerup) because those are\n             * essential for the touch-scroll engine to function.\n             */\n            const blockAdEvents = function(event) {\n                const epNum = getCurrentEpisodeNum();\n                if (epNum === 1) {\n                    setAdUnlocked();\n                    return;\n                }\n\n                const unlocked = isAdUnlockedOnly();\n\n                // If not unlocked, let the event trigger popup ads and record the unlock timestamp with 1s delay\n                if (!unlocked) {\n                    setTimeout(setAdUnlocked, 1000);\n                    return;\n                }\n\n                // Allow events on scroll infrastructure so vertical swipe still works\n                const isScrollInfra = event.target.closest('.v-scroll-container') &&\n                                     !event.target.closest('.player-wrap') &&\n                                     !event.target.closest('.v-sidebar') &&\n                                     !event.target.closest('.v-top-bar');\n                if (isScrollInfra) {\n                    return;\n                }\n\n                // Allow clicks on known core UI elements\n                const isInteractionOverlay = event.target.closest('.interaction-overlay');\n                const isUI = event.target.closest('video') ||\n                             event.target.closest('iframe') ||\n                             event.target.closest('.v-sidebar') ||\n                             event.target.closest('.v-top-bar') ||\n                             event.target.closest('.v-slide') ||\n                             event.target.closest('.autoplay-countdown') ||\n                             event.target.closest('.playlist-drawer') ||\n                             event.target.closest('.playlist-overlay') ||\n                             event.target.closest('.share-modal') ||\n                             event.target.closest('.modal-overlay') ||\n                             event.target.closest('#commentDrawer') ||\n                             event.target.closest('.toast-notification') ||\n                             isInteractionOverlay ||\n                             event.target.closest('#unmuteIndicator');\n\n                if (!isUI) {\n                    // Block ad overlay / background popunder clicks completely\n                    event.stopPropagation();\n                    event.preventDefault();\n                    console.log('[AdShield] Blocked ad ' + event.type + ' (Unlocked)');\n                } else if (isInteractionOverlay && (event.type === 'click' || event.type === 'mousedown')) {\n                    // Block the click from propagating to ad script, but trigger play/pause\n                    event.stopPropagation();\n                    if (event.type === 'click') {\n                        const playerWrap = isInteractionOverlay.closest('.player-wrap');\n                        if (playerWrap && typeof window.togglePlay === 'function') {\n                            window.togglePlay(playerWrap, event);\n                        }\n                    }\n                    console.log('[AdShield] Handled play/pause (Blocked ad propagation)');\n                }\n            };\n\n            // IMPORTANT: Only intercept mouse-type events. Do NOT intercept pointer events\n            // (pointerdown/pointerup) as they are used by the scroll engine for touch gestures.\n            const interceptEvents = ['click', 'mousedown', 'mouseup'];\n            interceptEvents.forEach(function(evt) {\n                window.addEventListener(evt, blockAdEvents, true);\n            });\n        })();\n    </script>\n\n    \n    <style>\n        /* GLOBAL RESET */\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            outline: none;\n            -webkit-tap-highlight-color: transparent;\n        }\n\n        /* VIEWPORT SETUP */\n        :root {\n            --app-height: 100%;\n            --c-primary: #e50914;\n        }\n\n        html,\n        body {\n            position: fixed;\n            width: 100%;\n            height: 100%;\n            /* Fallback */\n            height: 100dvh;\n            /* Modern Browser Fix for Address Bar */\n            background: #000;\n            overflow: hidden;\n            touch-action: none;\n            /* Disable Browser Scroll */\n            font-family: 'Inter', sans-serif;\n        }\n\n        /* HIDE DEFAULT ELEMENTS */\n        header,\n        footer,\n        #header,\n        #footer,\n        .nav-container,\n        .ads-container,\n        .announcement-bar {\n            display: none !important;\n        }\n\n        /* MAIN CONTAINER */\n        .v-scroll-container {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 10;\n            overflow: hidden;\n        }\n\n        .v-track {\n            display: flex;\n            flex-direction: column;\n            width: 100%;\n            height: 100%;\n            /* Scroll her zaman çalışsın */\n            pointer-events: auto !important;\n            touch-action: none;\n            will-change: transform;\n            /* Transition handled in JS or via class */\n        }\n\n        /* SLIDE LAYOUT */\n        .v-slide {\n            position: relative;\n            width: 100%;\n            height: 100dvh;\n            /* Exact Height */\n            flex-shrink: 0;\n            background: #000;\n            overflow: hidden;\n            /* GPU */\n            transform: translate3d(0, 0, 0);\n            backface-visibility: hidden;\n        }\n\n        /* LAYERS */\n        .player-wrap {\n            position: absolute;\n            inset: 0;\n            z-index: 1;\n            background: #000;\n            pointer-events: auto;\n            /* Interaction via overlay */\n        }\n\n        .player-wrap iframe {\n            width: 100%;\n            height: 100%;\n            border: none;\n            display: block !important;\n            pointer-events: auto;\n        }\n\n        /* Swipe zone - scroll için pasif, event'ler window level'da yakalanıyor */\n        .swipe-zone {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            z-index: 150;\n            background: transparent;\n            pointer-events: none !important;\n            /* Scroll'u engelleme */\n        }\n\n        .interaction-overlay {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 60px;\n            /* Kontrol barı için alt boşluk bırak */\n            z-index: 100;\n            background: transparent;\n            pointer-events: auto !important;\n            /* HER ZAMAN AKTİF: Android'te swipe hareketini iframe arkasına kaçırmadan ana sayfada yakalamak için */\n            cursor: pointer;\n            /* Cutout top-right 220px wide, 70px high for iframe controls like quality buttons */\n            clip-path: polygon(0 0, calc(100% - 220px) 0, calc(100% - 220px) 70px, 100% 70px, 100% 100%, 0 100%);\n        }\n\n        /* Iframe embedleri için overlay (vimeo, youtube) */\n        .player-wrap .interaction-overlay.iframe-mode {\n            bottom: 25% !important;\n            /* Alt tarafta kontroller için %25 boşluk bırak */\n            pointer-events: auto !important;\n            /* HER ZAMAN scroll ve click için aktif */\n        }\n\n        .lazy-player {\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n        }\n\n        /* VideoJS kontrol bar'ı overlay'in üstünde olsun */\n        .vjs-control-bar {\n            z-index: 300 !important;\n        }\n\n        /* VideoJS büyük play button da overlay'in üstünde */\n        .vjs-big-play-button {\n            z-index: 300 !important;\n        }\n\n        /* UI ELEMENTS */\n        .v-sidebar {\n            position: absolute;\n            right: 10px;\n            bottom: 30%;\n            /* Safe Area */\n            z-index: 200;\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n            align-items: center;\n            pointer-events: auto;\n        }\n\n        .v-btn {\n            background: transparent;\n            border: none;\n            color: #fff;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            font-size: 0.75rem;\n            gap: 5px;\n            cursor: pointer;\n            filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.5));\n        }\n\n        .v-btn i {\n            font-size: 1.8rem;\n        }\n\n        .v-btn.active {\n            color: var(--c-primary);\n        }\n\n        .v-info {\n            position: absolute;\n            bottom: 60px;\n            /* Safe Area */\n            left: 15px;\n            right: 80px;\n            /* Space for sidebar */\n            z-index: 15;\n            pointer-events: none;\n            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);\n            color: #fff;\n        }\n\n        .v-info h2 {\n            font-size: 1.1rem;\n            font-weight: 700;\n            margin-bottom: 5px;\n        }\n\n        .v-info p {\n            font-size: 0.85rem;\n            opacity: 0.9;\n            display: -webkit-box;\n            -webkit-line-clamp: 2;\n            -webkit-box-orient: vertical;\n            overflow: hidden;\n        }\n\n        /* MOBILE ADJUSTMENTS */\n        @media (max-width: 768px) {\n            .v-sidebar {\n                bottom: 35% !important;\n                /* Move up slightly */\n                right: 5px !important;\n            }\n\n            .v-info {\n                bottom: 80px !important;\n                /* Above controls properly */\n                left: 10px !important;\n                right: 60px !important;\n                /* Space for sidebar */\n            }\n\n            .v-btn i {\n                font-size: 1.6rem !important;\n            }\n\n            .v-btn span {\n                font-size: 0.7rem !important;\n            }\n        }\n\n        /* AD SLIDE STYLES */\n        .ad-slide-content {\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #111;\n            color: #fff;\n            position: relative;\n        }\n\n        .ad-badge {\n            position: absolute;\n            top: 20px;\n            right: 20px;\n            background: rgba(255, 255, 255, 0.2);\n            padding: 5px 10px;\n            border-radius: 4px;\n            font-size: 0.8rem;\n            font-weight: bold;\n        }\n\n        /* UI VISIBILITY STATE */\n        .v-ui-hidden .v-sidebar,\n        .v-ui-hidden .v-info,\n        .v-ui-hidden .v-top-bar {\n            opacity: 0;\n            pointer-events: none;\n            transition: opacity 0.3s ease;\n        }\n\n        /* AUTO-PLAY COUNTDOWN OVERLAY */\n        .autoplay-countdown {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: rgba(0, 0, 0, 0.85);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            z-index: 100;\n            opacity: 0;\n            pointer-events: none;\n            transition: opacity 0.5s ease;\n        }\n\n        .autoplay-countdown.active {\n            opacity: 1;\n            pointer-events: auto;\n        }\n\n        .autoplay-icon {\n            font-size: 3rem;\n            color: #e50914;\n            margin-bottom: 15px;\n            animation: pulse 1.5s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n\n            0%,\n            100% {\n                opacity: 1;\n            }\n\n            50% {\n                opacity: 0.5;\n            }\n        }\n\n        .autoplay-timer {\n            font-size: 4rem;\n            font-weight: bold;\n            color: #fff;\n            font-variant-numeric: tabular-nums;\n        }\n\n        .autoplay-text {\n            font-size: 1rem;\n            color: #ccc;\n            margin-top: 10px;\n        }\n\n        .autoplay-actions {\n            display: flex;\n            gap: 15px;\n            margin-top: 20px;\n        }\n\n        .autoplay-btn {\n            padding: 12px 24px;\n            border-radius: 8px;\n            border: none;\n            font-size: 1rem;\n            font-weight: bold;\n            cursor: pointer;\n            transition: all 0.2s;\n        }\n\n        .autoplay-btn-play {\n            background: #e50914;\n            color: #fff;\n        }\n\n        .autoplay-btn-play:hover {\n            background: #ff0f1f;\n            transform: scale(1.05);\n        }\n\n        .autoplay-btn-cancel {\n            background: rgba(255, 255, 255, 0.2);\n            color: #fff;\n            border: 1px solid rgba(255, 255, 255, 0.3);\n        }\n\n        .autoplay-btn-cancel:hover {\n            background: rgba(255, 255, 255, 0.3);\n        }\n\n        .v-sidebar,\n        .v-info,\n        .v-top-bar {\n            transition: opacity 0.3s ease;\n        }\n\n        /* TOP BAR */\n        .v-top-bar {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 60px;\n            z-index: 25;\n            pointer-events: none;\n        }\n\n        .idx-back-btn {\n            position: absolute;\n            top: 15px;\n            left: 15px;\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            background: rgba(0, 0, 0, 0.5);\n            color: #fff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            pointer-events: auto;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n\n        /* PLAYLIST DRAWER */\n        .playlist-drawer {\n            position: fixed;\n            bottom: -100%;\n            left: 0;\n            width: 100%;\n            background: rgba(18, 18, 18, 0.98);\n            backdrop-filter: blur(25px);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            border-radius: 24px 24px 0 0;\n            transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n            z-index: 2100;\n            padding: 30px 24px;\n            max-height: 75vh;\n            overflow-y: auto;\n            box-shadow: 0 -10px 40px rgba(0,0,0,0.5);\n        }\n\n        .playlist-drawer.open {\n            bottom: 0;\n        }\n\n        .playlist-drawer h3 {\n            margin: 0 0 24px 0;\n            font-size: 1.3rem;\n            color: #fff;\n            font-weight: 800;\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            letter-spacing: -0.5px;\n        }\n\n        .playlist-item {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 16px 20px;\n            background: rgba(255, 255, 255, 0.05);\n            margin-bottom: 12px;\n            border-radius: 16px;\n            cursor: pointer;\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        .playlist-item:hover {\n            background: rgba(255, 255, 255, 0.08);\n            transform: translateX(4px);\n        }\n\n        .playlist-item.active {\n            background: rgba(229, 9, 20, 0.15);\n            border-color: rgba(229, 9, 20, 0.4);\n        }\n\n        .playlist-item .list-name {\n            font-size: 1rem;\n            font-weight: 600;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        .playlist-item.active .list-name {\n            color: #fff;\n        }\n\n        .playlist-item .status-icon {\n            color: rgba(255, 255, 255, 0.2);\n            font-size: 1.3rem;\n            transition: all 0.3s ease;\n        }\n\n        .playlist-item.active .status-icon {\n            color: #e50914;\n            transform: scale(1.1);\n        }\n\n        .playlist-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(0, 0, 0, 0.85);\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.4s ease;\n            z-index: 2050;\n            backdrop-filter: blur(4px);\n        }\n\n        .playlist-overlay.open {\n            opacity: 1;\n            visibility: visible;\n        }\n\n        .drawer-close-btn {\n            position: absolute;\n            top: 24px;\n            right: 24px;\n            background: rgba(255, 255, 255, 0.1);\n            width: 36px;\n            height: 36px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n            color: #fff;\n            transition: all 0.2s ease;\n        }\n\n        .drawer-close-btn:hover {\n            transform: scale(1.1);\n            background: rgba(255, 255, 255, 0.2);\n        }\n\n        /* SHARE MODAL */\n        .share-modal {\n            position: fixed;\n            bottom: -100%;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 90%;\n            max-width: 400px;\n            background: #1a1a1a;\n            border-radius: 16px 16px 0 0;\n            padding: 25px 20px;\n            z-index: 2000;\n            transition: bottom 0.3s ease;\n        }\n\n        .share-modal.open {\n            bottom: 0;\n        }\n\n        /* TOAST NOTIFICATION */\n        .toast-notification {\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            background: rgba(0, 0, 0, 0.9);\n            color: #fff;\n            padding: 12px 20px;\n            border-radius: 6px;\n            font-size: 1rem;\n            font-weight: 500;\n            z-index: 2000;\n            opacity: 0;\n            pointer-events: none;\n            transition: opacity 0.2s ease;\n            text-align: center;\n        }\n\n        .toast-notification.show {\n            opacity: 1;\n        }\n\n        .toast-notification .toast-icon {\n            display: none;\n        }\n\n        .toast-notification .toast-text {\n            font-size: 1rem;\n            font-variant-numeric: tabular-nums;\n        }\n\n        /* WATERMARK / LOGO OVERLAY - Center */\n        .video-watermark {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            z-index: 10;\n            pointer-events: none !important;\n            animation: none !important;\n        }\n\n        .video-watermark img {\n            max-width: 200px;\n            max-height: 100px;\n            width: auto;\n            height: auto;\n            opacity: 0.5;\n            animation: none !important;\n            pointer-events: none !important;\n        }\n\n        @keyframes watermarkBreathe {\n\n            0%,\n            100% {\n                opacity: 0.7;\n            }\n\n            50% {\n                opacity: 1;\n            }\n        }\n\n        @keyframes watermarkPulse {\n\n            0%,\n            100% {\n                filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 10px rgba(229, 9, 20, 0.5));\n            }\n\n            50% {\n                filter: drop-shadow(0 0 15px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 20px rgba(229, 9, 20, 0.9));\n            }\n        }\n\n        @media (max-width: 768px) {\n            .video-watermark img {\n                max-width: 150px;\n                max-height: 75px;\n            }\n        }\n    </style>\n\n        <!-- Global Ad Script - Sadece 1. Bölümde Yüklenir -->\n    <script type=\"a6f0efca0c24a2e4b88d0c8d-text/javascript\">\n        (function () {\n            var s = document.createElement('script');\n            s.dataset.zone = '10460279';\n            s.src = 'https://al5sm.com/tag.min.js';\n            document.body.appendChild(s);\n        })();\n    </script>\n\n    <!-- GLOBAL AD CODES - Sadece 1. Bölümde -->\n        \n    <!-- TOP BAR -->\n    <main id=\"main-content\" tabindex=\"-1\">\n    <div class=\"v-top-bar\">\n        <a href=\"https://dramadizilerim.com/dizi/yeralti-vari-si\" class=\"idx-back-btn\"><i class=\"fas fa-arrow-left\"></i></a>\n    </div>\n\n    <div class=\"v-scroll-container\" id=\"mainScroller\">\n        <div class=\"v-track\" id=\"track\">\n            \n                <section class=\"v-slide\" data-index=\"0\" data-vid=\"1640\"\n                    data-epid=\"100806\"\n                    data-url=\"https://dramadizilerim.com/izle/yeralti-vari-si?s=1&e=1\" data-title=\"YERALTI VARİSİ - S1 B1\"\n                    data-valid=\"1\" data-iframe=\"0\"\n                    data-episode=\"1\"\n                    data-season=\"1\">\n\n                    <div class=\"player-wrap paused\" id=\"player-0\">\n                                                    <div class=\"interaction-overlay\" data-player-overlay=\"0\"></div>\n                                                                            <iframe src=\"https://dramadizilerim.com/embed.php?ct=qmd97njkSZrr8Ooc3J3b7C3ikcVw%2BFTmHO1VGF0DB2ruCHnl1tuQT%2BOpeKt%2BpbjnvtscKJLwQoJv8aiSRhcahYia%2FW3Ca8caupbA%2BhUztRrRUbI%2F4FTOFU4jkEqvCxzNx7J1urihgI%2BLVFUBzf648v5%2B36ZOR%2FB%2B%2FtscTeTMa%2F%2B1Yfc8jRzsq